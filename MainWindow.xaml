<Window x:Class="Lupik.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Lupik.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Lupik.Views"
        mc:Ignorable="d"
        Title="Lupik" Height="680" Width="960"
        WindowStartupLocation="Manual"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        Background="#131211"
        Foreground="#F6F1E9"
        FontFamily="{StaticResource AppFont}"
        ShowInTaskbar="True"
        Icon="app.ico"
        PreviewKeyDown="OnWindowKeyDown"
        PreviewKeyUp="OnWindowKeyUp"
        PreviewMouseDown="OnWindowMouseDown"
        Loaded="OnWindowLoaded">
    <!-- A normal captioned window drawn without its frame: Windows then animates it opening and closing
         (a WindowStyle="None" window just pops in) -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="38"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="FooterRow" Height="30"/>
        </Grid.RowDefinitions>

        <!-- Custom Dark Window Title Bar -->
        <Border x:Name="TitleBar" Grid.Row="0" Background="#1B1917" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="OnTitleBarMouseDown">
            <!-- Hairline in gold, fading out at both ends -->
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#2F2B27" Offset="0"/>
                    <GradientStop Color="#A8843A" Offset="0.5"/>
                    <GradientStop Color="#2F2B27" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <DockPanel LastChildFill="True">
                <!-- Close Button -->
                <Button DockPanel.Dock="Right" Width="44" Height="38"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" ToolTip="{loc:T main.closeTip}"
                        Click="OnCloseClicked">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Foreground" Value="#B5AB9D"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}">
                                            <views:LucideIcon Kind="x" Size="16" HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="#D9433A"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- File tools, top right -->
                <StackPanel x:Name="HeaderTools" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,6,0">
                    <Button x:Name="CropButton" Style="{StaticResource IconButton}" ToolTip="{loc:T main.cropTip}" Click="OnCropClicked">
                        <views:LucideIcon Kind="crop" Size="15"/>
                    </Button>
                    <Button x:Name="SaveAsButton" Style="{StaticResource IconButton}" ToolTip="{loc:T main.saveAsTip}" Click="OnSaveAsClicked">
                        <views:LucideIcon x:Name="SaveAsIcon" Kind="save" Size="15"/>
                    </Button>
                    <StackPanel x:Name="FileActions" Orientation="Horizontal">
                        <Button x:Name="PrintActionButton" Style="{StaticResource IconButton}" ToolTip="{loc:T main.printTip}" Click="OnPrintClicked">
                            <views:LucideIcon Kind="printer" Size="15"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="{loc:T main.showInFolderTip}" Click="OnShowInFolderClicked">
                            <views:LucideIcon Kind="folder-open" Size="15"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="{loc:T main.openDefaultTip}" Click="OnOpenDefaultClicked">
                            <views:LucideIcon Kind="square-arrow-out-up-right" Size="15"/>
                        </Button>
                        <Button x:Name="OpenWithButton" Style="{StaticResource IconButton}" ToolTip="{loc:T main.openWithTip}" Click="OnOpenWithClicked">
                            <views:LucideIcon Kind="app-window" Size="15"/>
                        </Button>
                        <Rectangle Width="1" Height="16" Fill="#3B3631" Margin="6,0"/>
                        <Button Style="{StaticResource DangerIconButton}" ToolTip="{loc:T main.deleteTip}" Click="OnDeleteClicked">
                            <views:LucideIcon Kind="trash-2" Size="15"/>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Back, file icon and name -->
                <DockPanel HorizontalAlignment="Left" LastChildFill="True" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="BackButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}" Margin="-6,0,4,0"
                            ToolTip="{loc:T main.backTip}" Click="OnBackClicked" Visibility="Collapsed">
                        <views:LucideIcon Kind="chevron-left" Size="16"/>
                    </Button>
                    <Image x:Name="TitleIconImage" DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="TitleFileNameText" Text="Lupik"
                               Foreground="#FBF8F2" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- Content Area Hosting Viewers -->
        <Grid Grid.Row="1" x:Name="ContentContainer">
            <views:ImageViewer x:Name="ImageViewerControl" Visibility="Collapsed"/>
            <views:CompareViewer x:Name="CompareViewerControl" Visibility="Collapsed"/>
            <views:DiffViewer x:Name="DiffViewerControl" Visibility="Collapsed"/>
            <views:CodeViewer x:Name="CodeViewerControl" Visibility="Collapsed"/>
            <views:PdfViewer x:Name="PdfViewerControl" Visibility="Collapsed"/>
            <views:GenericViewer x:Name="GenericViewerControl" Visibility="Collapsed"/>
            <views:ArchiveViewer x:Name="ArchiveViewerControl" Visibility="Collapsed"/>
            <views:CsvViewer x:Name="CsvViewerControl" Visibility="Collapsed"/>
            <views:DocxViewer x:Name="DocxViewerControl" Visibility="Collapsed"/>
            <views:FolderViewer x:Name="FolderViewerControl" Visibility="Collapsed"/>
            <views:PreviewHandlerHost x:Name="SystemPreviewControl" Visibility="Collapsed"/>
            <views:MediaViewer x:Name="MediaViewerControl" Visibility="Collapsed"/>

            <!-- Welcome: shown when Lupik is opened with nothing selected -->
            <Grid x:Name="WelcomeView" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" MaxWidth="560" Margin="24">
                    <!-- Mark: gold eye in a soft glow -->
                    <Grid Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,22">
                        <Ellipse>
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#40E3B341" Offset="0"/>
                                    <GradientStop Color="#00E3B341" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Border Width="64" Height="64" CornerRadius="20" Background="{StaticResource GoldGradient}">
                            <views:LucideIcon Kind="eye" Size="30" StrokeWidth="2" HorizontalAlignment="Center" TextElement.Foreground="#1A1407"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="Lupik" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold"
                               Foreground="#FBF8F2" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="WelcomeSubtitle"
                               FontSize="13.5" Foreground="#B5AB9D" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,8,0,28"/>

                    <!-- Shortcuts as key caps -->
                    <Border Background="#1B1917" BorderBrush="#2F2B27" BorderThickness="1" CornerRadius="12" Padding="20,14">
                        <Border.Resources>
                            <Style x:Key="Cap" TargetType="Border">
                                <Setter Property="Background" Value="#24211E"/>
                                <Setter Property="BorderBrush" Value="#3B3631"/>
                                <Setter Property="BorderThickness" Value="1,1,1,2"/>
                                <Setter Property="CornerRadius" Value="5"/>
                                <Setter Property="Padding" Value="7,2,7,3"/>
                                <Setter Property="Margin" Value="0,0,4,0"/>
                            </Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </Border.Resources>
                        <UniformGrid Columns="2" TextElement.Foreground="#B5AB9D">
                            <StackPanel Orientation="Horizontal" Margin="0,5,28,5">
                                <Border Style="{StaticResource Cap}"><TextBlock Text="{loc:T key.preview}" Foreground="#F0C95E"/></Border>
                                <TextBlock Text="{loc:T welcome.previewClose}" Margin="6,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5,28,5">
                                <Border Style="{StaticResource Cap}"><TextBlock Text="←" Foreground="#F0C95E"/></Border>
                                <Border Style="{StaticResource Cap}"><TextBlock Text="→" Foreground="#F0C95E"/></Border>
                                <TextBlock Text="{loc:T welcome.nextFile}" Margin="6,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5,28,5">
                                <Border Style="{StaticResource Cap}"><TextBlock Text="Enter" Foreground="#F0C95E"/></Border>
                                <TextBlock Text="{loc:T welcome.openInApp}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </UniformGrid>
                    </Border>

                    <TextBlock Text="{loc:T welcome.samples}" FontSize="10.5" FontWeight="SemiBold" Foreground="#8A8074"
                               HorizontalAlignment="Center" Margin="0,28,0,10"/>
                    <WrapPanel HorizontalAlignment="Center">
                        <WrapPanel.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Setter Property="Margin" Value="4"/>
                                <Setter Property="Padding" Value="12,7"/>
                                <Setter Property="FontSize" Value="12.5"/>
                            </Style>
                        </WrapPanel.Resources>
                        <Button x:Name="BtnSampleImage" Click="OnSampleImageClicked"><StackPanel Orientation="Horizontal"><views:LucideIcon Kind="image" Size="14" Margin="0,0,7,0" TextElement.Foreground="#E3B341"/><TextBlock Text="{loc:T welcome.sampleImage}" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button x:Name="BtnSampleVector" Click="OnSampleVectorClicked"><StackPanel Orientation="Horizontal"><views:LucideIcon Kind="pen-tool" Size="14" Margin="0,0,7,0" TextElement.Foreground="#E3B341"/><TextBlock Text="{loc:T welcome.sampleVector}" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button x:Name="BtnSampleCode" Click="OnSampleCodeClicked"><StackPanel Orientation="Horizontal"><views:LucideIcon Kind="code" Size="14" Margin="0,0,7,0" TextElement.Foreground="#E3B341"/><TextBlock Text="{loc:T welcome.sampleCode}" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button x:Name="BtnSamplePdf" Click="OnSamplePdfClicked"><StackPanel Orientation="Horizontal"><views:LucideIcon Kind="file-text" Size="14" Margin="0,0,7,0" TextElement.Foreground="#E3B341"/><TextBlock Text="PDF" VerticalAlignment="Center"/></StackPanel></Button>
                    </WrapPanel>
                </StackPanel>
            </Grid>

            <!-- Search (Ctrl+F): floats at the top right, below the viewer's toolbar. Typing comes through the keyboard hook -->
            <Border x:Name="SearchBar" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,52,18,0"
                    Background="#F21B1917" BorderBrush="#E3B341" BorderThickness="1" CornerRadius="10" Padding="12,6,6,6">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.5" Color="Black"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <views:LucideIcon Kind="search" Size="14" Margin="0,0,9,0" VerticalAlignment="Center" TextElement.Foreground="#E3B341"/>
                    <Grid MinWidth="190" MaxWidth="340" VerticalAlignment="Center">
                        <TextBlock x:Name="SearchPlaceholder" Text="{loc:T search.placeholder}" Foreground="#6F665B" FontSize="13"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="SearchText" Foreground="#FBF8F2" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="330"/>
                            <Rectangle x:Name="SearchCaret" Width="1.5" Height="16" Fill="#E3B341" Margin="1,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="SearchCount" Foreground="#8A8074" FontSize="12" VerticalAlignment="Center" Margin="12,0,6,0" MinWidth="44" TextAlignment="Right"/>
                    <Button Style="{StaticResource IconButton}" ToolTip="{loc:T search.prevTip}" Click="OnSearchPrevClicked">
                        <views:LucideIcon Kind="chevron-up" Size="15"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="{loc:T search.nextTip}" Click="OnSearchNextClicked">
                        <views:LucideIcon Kind="chevron-down" Size="15"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="{loc:T search.closeTip}" Click="OnSearchCloseClicked">
                        <views:LucideIcon Kind="x" Size="14"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Loading overlay: appears only when a file takes a moment to load -->
            <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Background="#B3131211">
                <Border Background="#1B1917" BorderBrush="#2F2B27" BorderThickness="1" CornerRadius="12"
                        Padding="28,22" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                    <StackPanel>
                        <views:LucideIcon Kind="loader-circle" Size="34" StrokeWidth="2.25" HorizontalAlignment="Center" Margin="0,0,0,14"
                                          TextElement.Foreground="#E3B341" RenderTransformOrigin="0.5,0.5">
                            <views:LucideIcon.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotation"/>
                            </views:LucideIcon.RenderTransform>
                        </views:LucideIcon>
                        <TextBlock Text="{loc:T main.loading}" Foreground="#FBF8F2" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="LoadingFileText" Foreground="#8A8074" FontSize="12" Margin="0,4,0,0"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        <!-- Keyboard hints, centered at the bottom -->
        <Border x:Name="FooterBar" Grid.Row="2" Background="#1B1917" BorderBrush="#2F2B27" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="#8A8074">
                <StackPanel.Resources>
                    <Style x:Key="Cap" TargetType="Border">
                        <Setter Property="BorderBrush" Value="#3B3631"/>
                        <Setter Property="BorderThickness" Value="1,1,1,2"/>
                        <Setter Property="CornerRadius" Value="4"/>
                        <Setter Property="Padding" Value="5,0,5,1"/>
                        <Setter Property="Margin" Value="0,0,3,0"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </StackPanel.Resources>
                <Border Style="{StaticResource Cap}"><TextBlock Text="←" FontSize="10.5" Foreground="#B5AB9D"/></Border>
                <Border Style="{StaticResource Cap}"><TextBlock Text="→" FontSize="10.5" Foreground="#B5AB9D"/></Border>
                <TextBlock Text="{loc:T hint.prevNext}" FontSize="11" VerticalAlignment="Center" Margin="3,0,18,0"/>
                <Border Style="{StaticResource Cap}"><TextBlock Text="{loc:T key.preview}" FontSize="10.5" Foreground="#B5AB9D"/></Border>
                <TextBlock Text="{loc:T hint.close}" FontSize="11" VerticalAlignment="Center" Margin="3,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
