<Window x:Class="QuickPeek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:QuickPeek.Views"
        mc:Ignorable="d"
        Title="QuickPeek" Height="680" Width="960"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#18181B"
        Foreground="#F4F4F5"
        ShowInTaskbar="True"
        Icon="app.ico"
        PreviewKeyDown="OnWindowKeyDown"
        PreviewMouseDown="OnWindowMouseDown"
        Loaded="OnWindowLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="38"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Dark Window Title Bar -->
        <Border x:Name="TitleBar" Grid.Row="0" Background="#1F1F23" BorderBrush="#2E2E33" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="OnTitleBarMouseDown">
            <DockPanel LastChildFill="True">
                <!-- Close Button -->
                <Button DockPanel.Dock="Right" Width="44" Height="38"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" ToolTip="Zamknij (Spacja/Esc)"
                        Click="OnCloseClicked">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Foreground" Value="#A1A1AA"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}">
                                            <views:LucideIcon Kind="x" Size="16" HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="#E11D48"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Navigation hint -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,12,0"
                            TextElement.Foreground="#71717A">
                    <views:LucideIcon Kind="arrow-left-right" Size="13" Margin="0,0,5,0"/>
                    <TextBlock Text="Następny/Poprzedni" FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <views:LucideIcon Kind="space" Size="13" Margin="0,0,5,0"/>
                    <TextBlock Text="/ Esc  Zamknij" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- File icon, name and Save As right next to it.
                     Left-aligned DockPanel: shrinks to content, but still trims a long name before the button. -->
                <DockPanel HorizontalAlignment="Left" LastChildFill="True" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="BackButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}" Margin="-6,0,4,0"
                            ToolTip="Wróć do folderu (Backspace)" Click="OnBackClicked" Visibility="Collapsed">
                        <views:LucideIcon Kind="chevron-left" Size="16"/>
                    </Button>
                    <Image x:Name="TitleIconImage" DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <!-- Quick actions (docked first, so they sit right of Save As) -->
                    <StackPanel x:Name="FileActions" DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="PrintActionButton" Style="{StaticResource IconButton}" ToolTip="Drukuj… (Ctrl+P)" Click="OnPrintClicked">
                            <views:LucideIcon Kind="printer" Size="15"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="Pokaż w folderze" Click="OnShowInFolderClicked">
                            <views:LucideIcon Kind="folder-open" Size="15"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="Otwórz w domyślnym programie (Enter)" Click="OnOpenDefaultClicked">
                            <views:LucideIcon Kind="square-arrow-out-up-right" Size="15"/>
                        </Button>
                        <Button x:Name="OpenWithButton" Style="{StaticResource IconButton}" ToolTip="Otwórz za pomocą… (np. Photoshop)" Click="OnOpenWithClicked">
                            <views:LucideIcon Kind="app-window" Size="15"/>
                        </Button>
                    </StackPanel>
                    <Button x:Name="SaveAsButton" DockPanel.Dock="Right" Width="28" Height="26" Margin="8,0,0,0"
                            Cursor="Hand" ToolTip="Zapisz jako… (Ctrl+S)"
                            Click="OnSaveAsClicked">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="#A1A1AA"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#3F3F46"/>
                                                    <Setter Property="Foreground" Value="#FAFAFA"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <views:LucideIcon x:Name="SaveAsIcon" Kind="save" Size="15"/>
                    </Button>
                    <TextBlock x:Name="TitleFileNameText" Text="QuickPeek"
                               Foreground="#FAFAFA" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- Content Area Hosting Viewers -->
        <Grid Grid.Row="1" x:Name="ContentContainer">
            <views:ImageViewer x:Name="ImageViewerControl" Visibility="Collapsed"/>
            <views:CompareViewer x:Name="CompareViewerControl" Visibility="Collapsed"/>
            <views:CodeViewer x:Name="CodeViewerControl" Visibility="Collapsed"/>
            <views:PdfViewer x:Name="PdfViewerControl" Visibility="Collapsed"/>
            <views:GenericViewer x:Name="GenericViewerControl" Visibility="Collapsed"/>
            <views:ArchiveViewer x:Name="ArchiveViewerControl" Visibility="Collapsed"/>
            <views:CsvViewer x:Name="CsvViewerControl" Visibility="Collapsed"/>
            <views:FolderViewer x:Name="FolderViewerControl" Visibility="Collapsed"/>
            <views:PreviewHandlerHost x:Name="SystemPreviewControl" Visibility="Collapsed"/>

            <!-- Welcome / Ready View when no file is selected -->
            <Grid x:Name="WelcomeView" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="#1C1C20" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="16" Padding="36" Width="600">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="64" Height="64" CornerRadius="32" Background="#27272A" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <views:LucideIcon Kind="eye" Size="30" StrokeWidth="1.75" HorizontalAlignment="Center" TextElement.Foreground="#CBA6F7"/>
                        </Border>
                        <TextBlock Text="QuickPeek jest aktywny i gotowy!" FontSize="20" FontWeight="Bold" Foreground="#FAFAFA" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Zaznacz plik na Pulpicie lub w Eksploratorze i naciśnij SPACJĘ" FontSize="13" Foreground="#A1A1AA" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <Border Background="#27272A" CornerRadius="8" Padding="10,6" Margin="4">
                                <StackPanel Orientation="Horizontal" TextElement.Foreground="#38BDF8"><views:LucideIcon Kind="keyboard" Size="13" Margin="0,0,6,0"/><TextBlock Text="Spacja = Podgląd / Zamknij" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                            </Border>
                            <Border Background="#27272A" CornerRadius="8" Padding="10,6" Margin="4">
                                <StackPanel Orientation="Horizontal" TextElement.Foreground="#38BDF8"><views:LucideIcon Kind="keyboard" Size="13" Margin="0,0,6,0"/><TextBlock Text="Ctrl+Spacja = Skrót globalny" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                            </Border>
                            <Border Background="#27272A" CornerRadius="8" Padding="10,6" Margin="4">
                                <StackPanel Orientation="Horizontal" TextElement.Foreground="#38BDF8"><views:LucideIcon Kind="keyboard" Size="13" Margin="0,0,6,0"/><TextBlock Text="←/→ = Następny plik" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Wypróbuj przykładowe pliki testowe:" FontSize="12" Foreground="#71717A" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="BtnSampleImage" Margin="4" Padding="12,6" Background="#27272A" Foreground="#E4E4E7" BorderBrush="#3F3F46" Cursor="Hand" Click="OnSampleImageClicked"><StackPanel Orientation="Horizontal"><views:LucideIcon Kind="image" Size="14" Margin="0,0,7,0"/><TextBlock Text="Próbka grafiki" VerticalAlignment="Center"/></StackPanel></Button>
                            <Button x:Name="BtnSampleCode" Margin="4" Padding="12,6" Background="#27272A" Foreground="#E4E4E7" BorderBrush="#3F3F46" Cursor="Hand" Click="OnSampleCodeClicked"><StackPanel Orientation="Horizontal"><views:LucideIcon Kind="code" Size="14" Margin="0,0,7,0"/><TextBlock Text="Próbka kodu" VerticalAlignment="Center"/></StackPanel></Button>
                            <Button x:Name="BtnSamplePdf" Margin="4" Padding="12,6" Background="#27272A" Foreground="#E4E4E7" BorderBrush="#3F3F46" Cursor="Hand" Click="OnSamplePdfClicked"><StackPanel Orientation="Horizontal"><views:LucideIcon Kind="file-text" Size="14" Margin="0,0,7,0"/><TextBlock Text="Próbka PDF" VerticalAlignment="Center"/></StackPanel></Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Loading overlay: appears only when a file takes a moment to load -->
            <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Background="#B318181B">
                <Border Background="#1F1F23" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="12"
                        Padding="28,22" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                    <StackPanel>
                        <views:LucideIcon Kind="loader-circle" Size="34" StrokeWidth="2.25" HorizontalAlignment="Center" Margin="0,0,0,14"
                                          TextElement.Foreground="#CBA6F7" RenderTransformOrigin="0.5,0.5">
                            <views:LucideIcon.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotation"/>
                            </views:LucideIcon.RenderTransform>
                        </views:LucideIcon>
                        <TextBlock Text="Wczytywanie…" Foreground="#FAFAFA" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="LoadingFileText" Foreground="#71717A" FontSize="12" Margin="0,4,0,0"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
