<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 API set: needed for the built-in OCR (Windows.Media.Ocr) -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <!-- precompiled native code on publish: faster startup / first preview -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- This is a WPF app; WinForms is used for shell helpers, not its DPI startup API. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <StartupObject>Lupik.Program</StartupObject>
    <!-- Windows x64 only: without it every build also copies Magick.NET and PDFium for Linux, macOS, ARM and x86 (~125 MB) -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <Version>1.9.0</Version>
    <Product>Lupik</Product>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <InternalsVisibleTo Include="PreviewReleaseTests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <EmbeddedResource Include="Localization\Strings\*.json" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="test_samples\**" />
    <Compile Remove="tools\**" />
    <None Include="test_samples\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="licenses\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- FFmpeg (audio / video edits) ships next to Lupik; tools/get-ffmpeg.ps1 fetches it, it isn't kept in git -->
    <None Include="tools\ffmpeg\ffmpeg.exe" Link="ffmpeg\ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="tools\ffmpeg\LICENSE.txt" Link="licenses\ffmpeg\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="FetchFfmpeg" BeforeTargets="BeforeBuild" Condition="!Exists('$(MSBuildProjectDirectory)\tools\ffmpeg\ffmpeg.exe')">
    <!-- Windows PowerShell's own module path: dotnet passes PowerShell 7's on, where its cmdlets aren't found -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tools\get-ffmpeg.ps1&quot; -Destination &quot;$(MSBuildProjectDirectory)\tools\ffmpeg&quot;"
          EnvironmentVariables="PSModulePath=$(SystemRoot)\System32\WindowsPowerShell\v1.0\Modules" />
  </Target>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="bblanchon.PDFium.Win32" Version="156.0.8076" />
    <PackageReference Include="DiffPlex" Version="1.9.0" />
    <PackageReference Include="Magick.NET-Q8-x64" Version="14.17.2" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.12" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

</Project>
