<Window x:Class="Lupik.Views.PrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Lupik.Localization"
        xmlns:views="clr-namespace:Lupik.Views"
        Title="{loc:T print.title}" Width="1000" Height="700" MinWidth="820" MinHeight="560"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#131211" Foreground="#ECE6DC"
        PreviewKeyDown="OnKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B5AB9D"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#161412"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#E3B341" CornerRadius="6" Padding="18,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0C95E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#2F2B27" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Preview ===== -->
            <Grid Grid.Column="0" Background="#0E0D0C">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid x:Name="PreviewArea" Margin="36,36,36,12" SizeChanged="OnPreviewAreaSizeChanged">
                    <!-- The sheet of paper, shaped like the selected paper size and orientation -->
                    <Border x:Name="Paper" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5"/>
                        </Border.Effect>
                        <Grid x:Name="Printable" ClipToBounds="True">
                            <Image x:Name="PageImage" RenderOptions.BitmapScalingMode="HighQuality"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="PreviewStatus" Text="{loc:T print.preparing}" Foreground="#8A8074" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Button x:Name="PrevPageButton" Style="{StaticResource IconButton}" ToolTip="{loc:T print.prevPage}" Click="OnPrevPage">
                        <views:LucideIcon Kind="chevron-left" Size="16"/>
                    </Button>
                    <TextBlock x:Name="PageIndicator" Text="" Foreground="#B5AB9D" FontSize="12"
                               VerticalAlignment="Center" Margin="10,0" MinWidth="90" TextAlignment="Center"/>
                    <Button x:Name="NextPageButton" Style="{StaticResource IconButton}" ToolTip="{loc:T print.nextPage}" Click="OnNextPage">
                        <views:LucideIcon Kind="chevron-right" Size="16"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===== Settings ===== -->
            <Grid Grid.Column="1" Background="#181614">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header (also the drag handle) -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseDown" Margin="22,16,12,4">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <views:LucideIcon Kind="printer" Size="18" Margin="0,0,10,0" TextElement.Foreground="#E3B341"/>
                            <TextBlock Text="{loc:T print.title}" FontSize="18" FontWeight="SemiBold" Foreground="#FBF8F2" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="SheetsText" Foreground="#8A8074" FontSize="12" Margin="28,4,0,0"/>
                    </StackPanel>
                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                            ToolTip="{loc:T common.closeEsc}" Click="OnCancel">
                        <views:LucideIcon Kind="x" Size="15"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,0,22,8">
                    <StackPanel>
                        <TextBlock Text="{loc:T print.printer}" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="PrinterBox" Style="{StaticResource DarkComboBox}" MaxDropDownHeight="320"
                                  SelectionChanged="OnPrinterChanged"/>
                        <TextBlock x:Name="PrinterInfo" Foreground="#8A8074" FontSize="11" Margin="2,5,0,0" TextWrapping="Wrap"/>

                        <TextBlock Text="{loc:T print.pages}" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="PagesModeBox" Style="{StaticResource DarkComboBox}" SelectionChanged="OnPagesModeChanged">
                            <ComboBoxItem Content="{loc:T print.pagesAll}" IsSelected="True"/>
                            <ComboBoxItem Content="{loc:T print.pagesOdd}"/>
                            <ComboBoxItem Content="{loc:T print.pagesEven}"/>
                            <ComboBoxItem Content="{loc:T print.pagesCustom}"/>
                        </ComboBox>
                        <TextBox x:Name="PageRangeBox" Style="{StaticResource DarkTextBox}" Margin="0,8,0,0" Visibility="Collapsed"
                                 ToolTip="{loc:T print.rangeTip}" TextChanged="OnSettingChanged"/>

                        <TextBlock Text="{loc:T print.copies}" Style="{StaticResource Label}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CopiesBox" Style="{StaticResource DarkTextBox}" Text="1" TextChanged="OnSettingChanged"
                                     PreviewTextInput="OnCopiesTextInput"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                <Button Style="{StaticResource IconButton}" Width="32" Height="32" Click="OnCopiesMinus" ToolTip="{loc:T print.fewer}">
                                    <views:LucideIcon Kind="minus" Size="14"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Width="32" Height="32" Click="OnCopiesPlus" ToolTip="{loc:T print.more}">
                                    <views:LucideIcon Kind="plus" Size="14"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="CollateBox" Content="{loc:T print.collate}" IsChecked="True" Foreground="#B5AB9D"
                                  FontSize="12" Margin="2,8,0,0" Visibility="Collapsed" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>

                        <TextBlock Text="{loc:T print.layout}" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="OrientationBox" Style="{StaticResource DarkComboBox}" SelectionChanged="OnSettingChanged">
                            <ComboBoxItem Content="{loc:T print.layoutAuto}" IsSelected="True"/>
                            <ComboBoxItem Content="{loc:T print.portrait}"/>
                            <ComboBoxItem Content="{loc:T print.landscape}"/>
                        </ComboBox>

                        <TextBlock Text="{loc:T print.color}" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="ColorBox" Style="{StaticResource DarkComboBox}" SelectionChanged="OnSettingChanged">
                            <ComboBoxItem Content="{loc:T print.color}" IsSelected="True"/>
                            <ComboBoxItem Content="{loc:T print.mono}"/>
                        </ComboBox>

                        <StackPanel x:Name="DuplexPanel">
                            <TextBlock Text="{loc:T print.duplex}" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="DuplexBox" Style="{StaticResource DarkComboBox}" SelectionChanged="OnSettingChanged">
                                <ComboBoxItem Content="{loc:T print.simplex}" IsSelected="True"/>
                                <ComboBoxItem Content="{loc:T print.duplexLong}"/>
                                <ComboBoxItem Content="{loc:T print.duplexShort}"/>
                            </ComboBox>
                        </StackPanel>

                        <TextBlock Text="{loc:T print.paper}" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="PaperBox" Style="{StaticResource DarkComboBox}" MaxDropDownHeight="320" SelectionChanged="OnSettingChanged"/>

                        <TextBlock Text="{loc:T print.scale}" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="ScaleBox" Style="{StaticResource DarkComboBox}" SelectionChanged="OnSettingChanged">
                            <ComboBoxItem Content="{loc:T print.fitPage}" IsSelected="True"/>
                            <ComboBoxItem Content="{loc:T print.actualSize}"/>
                        </ComboBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <Border Grid.Row="2" BorderBrush="#2F2B27" BorderThickness="0,1,0,0" Padding="22,14">
                    <Grid>
                        <TextBlock x:Name="StatusText" Foreground="#B5AB9D" FontSize="12" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,0,190,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource PillButton}" Content="{loc:T common.cancel}" Padding="16,8" Margin="0,0,8,0" Click="OnCancel"/>
                            <Button x:Name="PrintButton" Style="{StaticResource PrimaryButton}" Click="OnPrint" IsDefault="True">
                                <StackPanel Orientation="Horizontal">
                                    <views:LucideIcon Kind="printer" Size="15" Margin="0,0,8,0"/>
                                    <TextBlock Text="{loc:T print.title}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
