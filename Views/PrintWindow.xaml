<Window x:Class="QuickPeek.Views.PrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:QuickPeek.Views"
        Title="Drukuj" Width="1000" Height="700" MinWidth="820" MinHeight="560"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#18181B" Foreground="#E4E4E7"
        PreviewKeyDown="OnKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#CBA6F7" CornerRadius="6" Padding="18,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D8BBFA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#2E2E33" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Preview ===== -->
            <Grid Grid.Column="0" Background="#111113">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid x:Name="PreviewArea" Margin="36,36,36,12" SizeChanged="OnPreviewAreaSizeChanged">
                    <!-- The sheet of paper, shaped like the selected paper size and orientation -->
                    <Border x:Name="Paper" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5"/>
                        </Border.Effect>
                        <Grid x:Name="Printable" ClipToBounds="True">
                            <Image x:Name="PageImage" RenderOptions.BitmapScalingMode="HighQuality"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="PreviewStatus" Text="Przygotowywanie podglądu…" Foreground="#71717A" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Button x:Name="PrevPageButton" Style="{StaticResource IconButton}" ToolTip="Poprzednia strona" Click="OnPrevPage">
                        <views:LucideIcon Kind="chevron-left" Size="16"/>
                    </Button>
                    <TextBlock x:Name="PageIndicator" Text="Strona 1 z 1" Foreground="#A1A1AA" FontSize="12"
                               VerticalAlignment="Center" Margin="10,0" MinWidth="90" TextAlignment="Center"/>
                    <Button x:Name="NextPageButton" Style="{StaticResource IconButton}" ToolTip="Następna strona" Click="OnNextPage">
                        <views:LucideIcon Kind="chevron-right" Size="16"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===== Settings ===== -->
            <Grid Grid.Column="1" Background="#1C1C20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header (also the drag handle) -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseDown" Margin="22,16,12,4">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <views:LucideIcon Kind="printer" Size="18" Margin="0,0,10,0" TextElement.Foreground="#CBA6F7"/>
                            <TextBlock Text="Drukuj" FontSize="18" FontWeight="SemiBold" Foreground="#FAFAFA" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="SheetsText" Foreground="#71717A" FontSize="12" Margin="28,4,0,0"/>
                    </StackPanel>
                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                            ToolTip="Zamknij (Esc)" Click="OnCancel">
                        <views:LucideIcon Kind="x" Size="15"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,0,22,8">
                    <StackPanel>
                        <TextBlock Text="Drukarka" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="PrinterBox" Style="{StaticResource DarkComboBox}" MaxDropDownHeight="320"
                                  SelectionChanged="OnPrinterChanged"/>
                        <TextBlock x:Name="PrinterInfo" Foreground="#71717A" FontSize="11" Margin="2,5,0,0" TextWrapping="Wrap"/>

                        <TextBlock Text="Strony" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="PagesModeBox" Style="{StaticResource DarkComboBox}" SelectionChanged="OnPagesModeChanged">
                            <ComboBoxItem Content="Wszystkie" IsSelected="True"/>
                            <ComboBoxItem Content="Tylko nieparzyste"/>
                            <ComboBoxItem Content="Tylko parzyste"/>
                            <ComboBoxItem Content="Niestandardowe"/>
                        </ComboBox>
                        <TextBox x:Name="PageRangeBox" Style="{StaticResource DarkTextBox}" Margin="0,8,0,0" Visibility="Collapsed"
                                 ToolTip="np. 1-5, 8, 11-13" TextChanged="OnSettingChanged"/>

                        <TextBlock Text="Kopie" Style="{StaticResource Label}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CopiesBox" Style="{StaticResource DarkTextBox}" Text="1" TextChanged="OnSettingChanged"
                                     PreviewTextInput="OnCopiesTextInput"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                <Button Style="{StaticResource IconButton}" Width="32" Height="32" Click="OnCopiesMinus" ToolTip="Mniej">
                                    <views:LucideIcon Kind="minus" Size="14"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Width="32" Height="32" Click="OnCopiesPlus" ToolTip="Więcej">
                                    <views:LucideIcon Kind="plus" Size="14"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="CollateBox" Content="Sortuj kopie (1,2,3 · 1,2,3)" IsChecked="True" Foreground="#A1A1AA"
                                  FontSize="12" Margin="2,8,0,0" Visibility="Collapsed" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>

                        <TextBlock Text="Układ" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="OrientationBox" Style="{StaticResource DarkComboBox}" SelectionChanged="OnSettingChanged">
                            <ComboBoxItem Content="Automatyczny (wg strony)" IsSelected="True"/>
                            <ComboBoxItem Content="Pionowy"/>
                            <ComboBoxItem Content="Poziomy"/>
                        </ComboBox>

                        <TextBlock Text="Kolor" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="ColorBox" Style="{StaticResource DarkComboBox}" SelectionChanged="OnSettingChanged">
                            <ComboBoxItem Content="Kolor" IsSelected="True"/>
                            <ComboBoxItem Content="Czarno-biały"/>
                        </ComboBox>

                        <StackPanel x:Name="DuplexPanel">
                            <TextBlock Text="Druk dwustronny" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="DuplexBox" Style="{StaticResource DarkComboBox}" SelectionChanged="OnSettingChanged">
                                <ComboBoxItem Content="Jednostronnie" IsSelected="True"/>
                                <ComboBoxItem Content="Dwustronnie — obracaj wzdłuż dłuższej krawędzi"/>
                                <ComboBoxItem Content="Dwustronnie — obracaj wzdłuż krótszej krawędzi"/>
                            </ComboBox>
                        </StackPanel>

                        <TextBlock Text="Rozmiar papieru" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="PaperBox" Style="{StaticResource DarkComboBox}" MaxDropDownHeight="320" SelectionChanged="OnSettingChanged"/>

                        <TextBlock Text="Skala" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="ScaleBox" Style="{StaticResource DarkComboBox}" SelectionChanged="OnSettingChanged">
                            <ComboBoxItem Content="Dopasuj do strony" IsSelected="True"/>
                            <ComboBoxItem Content="Rzeczywisty rozmiar"/>
                        </ComboBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <Border Grid.Row="2" BorderBrush="#2E2E33" BorderThickness="0,1,0,0" Padding="22,14">
                    <Grid>
                        <TextBlock x:Name="StatusText" Foreground="#A1A1AA" FontSize="12" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,0,190,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource PillButton}" Content="Anuluj" Padding="16,8" Margin="0,0,8,0" Click="OnCancel"/>
                            <Button x:Name="PrintButton" Style="{StaticResource PrimaryButton}" Click="OnPrint" IsDefault="True">
                                <StackPanel Orientation="Horizontal">
                                    <views:LucideIcon Kind="printer" Size="15" Margin="0,0,8,0"/>
                                    <TextBlock Text="Drukuj" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
