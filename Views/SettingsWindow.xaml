<Window x:Class="Lupik.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Lupik.Localization"
        xmlns:views="clr-namespace:Lupik.Views"
        Title="{loc:T settings.windowTitle}"
        Icon="pack://application:,,,/Lupik;component/app.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Width="856" Height="636" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <!-- Left navigation -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="12,9">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource c221F1C}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource c2C2721}"/>
                                <Setter Property="Foreground" Value="{DynamicResource GoldHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- On/off switch -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="42" Height="24" CornerRadius="12" Background="{DynamicResource c3B3631}" Padding="3">
                            <Border x:Name="Knob" Width="18" Height="18" CornerRadius="9" Background="{DynamicResource cB5AB9D}" HorizontalAlignment="Left">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.35"/>
                                </Border.Effect>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Gold}"/>
                                <Setter TargetName="Knob" Property="Background" Value="{DynamicResource OnGold}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Gold slider -->
        <Style x:Key="SliderEdge" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GoldSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource c3B3631}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderEdge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource Gold}" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEdge}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="16" Height="16" Fill="{DynamicResource GoldHover}" Stroke="{DynamicResource c1B1917}" StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One setting: text on the left, control on the right -->
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource c211E1B}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource c2A2622}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Margin" Value="2,6,0,10"/>
        </Style>

        <!-- Language tile -->
        <!-- Must stay focusable: a ListBoxItem only gets selected on click if it can take the focus -->
        <Style x:Key="LangTile" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{DynamicResource c211E1B}" BorderBrush="{DynamicResource c2A2622}" BorderThickness="1" CornerRadius="10" Padding="12,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource c27231F}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource c3B3631}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GoldTintAlt}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Gold}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Field that records a key: click, then press the keys -->
        <Style x:Key="KeyField" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Foreground" Value="{DynamicResource GoldHover}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource c161412}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,8">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource c1E1B18}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="{DynamicResource c3B3631}"/>
        </Style>

        <!-- A choice drawn as a tile (theme, backdrop, picture background): a small picture above its name -->
        <Style x:Key="ChoiceTile" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{DynamicResource c211E1B}" BorderBrush="{DynamicResource c2A2622}" BorderThickness="1.5" CornerRadius="12" Padding="10,10,10,9">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource c27231F}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource c3B3631}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GoldTintAlt}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Gold}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The name under a tile's picture -->
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="2,8,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Window.Resources>

    <!-- Margin leaves room for the shadow around the card -->
    <Border x:Name="Card" Margin="28" Background="{DynamicResource c1B1917}" BorderBrush="{DynamicResource c35302A}" BorderThickness="1" CornerRadius="16"
            RenderTransformOrigin="0.5,0.5" Opacity="0">
        <Border.RenderTransform>
            <ScaleTransform x:Name="CardScale" ScaleX="0.97" ScaleY="0.97"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="10" Direction="270" Opacity="0.55" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation -->
            <Border Background="{DynamicResource c171513}" CornerRadius="16,0,0,16" BorderBrush="{DynamicResource c2A2622}" BorderThickness="0,0,1,0"
                    MouseLeftButtonDown="OnDrag">
                <DockPanel Margin="14,20,14,16">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,22">
                        <Image Source="{DynamicResource AppLogo}" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Lupik" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{loc:T settings.title}" FontSize="11.5" Foreground="{DynamicResource TextMuted}"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="VersionFooter" DockPanel.Dock="Bottom" FontSize="11" Foreground="{DynamicResource c6B6259}" Margin="8,0,0,0"/>
                    <StackPanel>
                        <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" IsChecked="True" Checked="OnNav">
                            <StackPanel Orientation="Horizontal">
                                <views:LucideIcon Kind="settings" Size="16" Margin="0,0,10,0"/>
                                <TextBlock Text="{loc:T settings.navGeneral}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavAppearance" Style="{StaticResource NavItem}" Checked="OnNav">
                            <StackPanel Orientation="Horizontal">
                                <views:LucideIcon Kind="palette" Size="16" Margin="0,0,10,0"/>
                                <TextBlock Text="{loc:T settings.navAppearance}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavKeys" Style="{StaticResource NavItem}" Checked="OnNav">
                            <StackPanel Orientation="Horizontal">
                                <views:LucideIcon Kind="keyboard" Size="16" Margin="0,0,10,0"/>
                                <TextBlock Text="{loc:T settings.navKeys}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavUpdates" Style="{StaticResource NavItem}" Checked="OnNav">
                            <StackPanel Orientation="Horizontal">
                                <views:LucideIcon Kind="refresh-cw" Size="16" Margin="0,0,10,0"/>
                                <TextBlock Text="{loc:T settings.navUpdates}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Checked="OnNav">
                            <StackPanel Orientation="Horizontal">
                                <views:LucideIcon Kind="info" Size="16" Margin="0,0,10,0"/>
                                <TextBlock Text="{loc:T settings.navAbout}"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Pages -->
            <DockPanel Grid.Column="1">
                <Grid DockPanel.Dock="Top" Margin="28,18,14,6" Background="Transparent" MouseLeftButtonDown="OnDrag">
                    <TextBlock x:Name="PageTitle" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Click="OnClose" ToolTip="{loc:T common.closeEsc}">
                        <views:LucideIcon Kind="x" Size="16"/>
                    </Button>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,6,28,24">
                    <Grid>
                        <!-- General -->
                        <StackPanel x:Name="PageGeneral">
                            <TextBlock Text="{loc:T settings.language}" Style="{StaticResource SectionTitle}"/>
                            <ListBox x:Name="LanguageList" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,-8,6"
                                     ItemContainerStyle="{StaticResource LangTile}" SelectionChanged="OnLanguageSelected"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>

                            <TextBlock Text="{loc:T settings.behaviour}" Style="{StaticResource SectionTitle}" Margin="2,10,0,10"/>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <CheckBox x:Name="StartupSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="OnStartupClick"/>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="{loc:T settings.startup}" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="{loc:T settings.startupHint}" Style="{StaticResource RowHint}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <CheckBox x:Name="FocusLossSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="OnFocusLossClick"/>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="{loc:T settings.closeOnFocusLoss}" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="{loc:T settings.closeOnFocusLossHint}" Style="{StaticResource RowHint}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <CheckBox x:Name="AutoplaySwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="OnAutoplayClick"/>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="{loc:T settings.autoplay}" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="{loc:T settings.autoplayHint}" Style="{StaticResource RowHint}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <CheckBox x:Name="RememberBoundsSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="OnRememberBoundsClick"/>
                                    <Button x:Name="ForgetBoundsButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="12"
                                            Margin="0,0,14,0" VerticalAlignment="Center" Click="OnForgetBounds">
                                        <StackPanel Orientation="Horizontal">
                                            <views:LucideIcon Kind="rotate-ccw" Size="12" Margin="0,0,6,0"/>
                                            <TextBlock Text="{loc:T settings.forgetBounds}"/>
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="{loc:T settings.rememberBounds}" Style="{StaticResource RowTitle}"/>
                                        <TextBlock x:Name="RememberBoundsHint" Text="{loc:T settings.rememberBoundsHint}" Style="{StaticResource RowHint}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock x:Name="ScaleText" DockPanel.Dock="Right" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource GoldHover}"/>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="{loc:T settings.windowSize}" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="{loc:T settings.windowSizeHint}" Style="{StaticResource RowHint}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <Slider x:Name="ScaleSlider" Style="{StaticResource GoldSlider}" Minimum="60" Maximum="100" SmallChange="5" LargeChange="10"
                                            TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,12,0,0" ValueChanged="OnScaleChanged"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Appearance: theme, backdrop, Lupik's color, picture background -->
                        <StackPanel x:Name="PageAppearance" Visibility="Collapsed">
                            <!-- A small Lupik window drawn with the live accent: every change shows here at once -->
                            <Border CornerRadius="12" Background="{DynamicResource c131211}" BorderBrush="{DynamicResource c2F2B27}" BorderThickness="1" Margin="0,4,0,20"
                                    IsHitTestVisible="False">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.35"/>
                                </Border.Effect>
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Background="{DynamicResource c1B1917}" CornerRadius="11,11,0,0" Padding="12,9" BorderThickness="0,0,0,1">
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="{DynamicResource c2F2B27Color}" Offset="0"/>
                                                <GradientStop Color="{DynamicResource GoldHairlineColor}" Offset="0.5"/>
                                                <GradientStop Color="{DynamicResource c2F2B27Color}" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="100%" Foreground="{DynamicResource Gold}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                <views:LucideIcon Kind="search" Size="14" Margin="0,0,12,0" TextElement.Foreground="{DynamicResource GoldHover}"/>
                                                <views:LucideIcon Kind="x" Size="14" TextElement.Foreground="{DynamicResource TextSecondary}"/>
                                            </StackPanel>
                                            <Image Source="{DynamicResource AppLogo}" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="Lupik.pdf" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" Margin="9,0,8,0" VerticalAlignment="Center"/>
                                            <Border Background="{DynamicResource Gold}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <TextBlock Text="PDF" Foreground="{DynamicResource OnGold}" FontSize="10.5" FontWeight="Bold"/>
                                            </Border>
                                        </DockPanel>
                                    </Border>
                                    <StackPanel Margin="16,14,16,16">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{DynamicResource GoldTint}" BorderBrush="{DynamicResource GoldDeep}" BorderThickness="1" CornerRadius="10" Padding="9,2" VerticalAlignment="Center">
                                                <TextBlock Text="C#" Foreground="{DynamicResource Gold}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Background="{DynamicResource cF21B1917}" BorderBrush="{DynamicResource Gold}" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="10,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <views:LucideIcon Kind="search" Size="12" Margin="0,0,7,0" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource Gold}"/>
                                                    <TextBlock Text="Lupik" FontSize="12" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                                    <Rectangle Width="1.5" Height="13" Fill="{DynamicResource Gold}" Margin="1,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <views:LucideIcon Kind="info" Size="14" Margin="14,0,6,0" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource GoldPressed}"/>
                                            <TextBlock Text="{loc:T settings.accentSample}" FontSize="12" Foreground="{DynamicResource GoldPressed}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <DockPanel Margin="0,14,0,0">
                                            <Button DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}" Padding="14,7">
                                                <StackPanel Orientation="Horizontal">
                                                    <views:LucideIcon Kind="save" Size="13" Margin="0,0,7,0"/>
                                                    <TextBlock Text="{loc:T edit.save}" VerticalAlignment="Center"/>
                                                    <Border Style="{StaticResource KeyHint}"><TextBlock Text="Enter" FontSize="10" Foreground="{DynamicResource OnGoldHint}"/></Border>
                                                </StackPanel>
                                            </Button>
                                            <CheckBox DockPanel.Dock="Left" Style="{StaticResource Switch}" IsChecked="True" Margin="14,0,0,0"/>
                                            <Slider Style="{StaticResource GoldSlider}" Minimum="0" Maximum="100" Value="64" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <TextBlock Text="{loc:T settings.theme}" Style="{StaticResource SectionTitle}"/>
                            <UniformGrid Columns="3" Margin="0,0,-8,6">
                                <RadioButton x:Name="ThemeDark" Style="{StaticResource ChoiceTile}" GroupName="Theme" Tag="dark" Checked="OnThemeChecked">
                                    <StackPanel>
                                        <Border Height="62" CornerRadius="7" Background="#131211" BorderBrush="#35302A" BorderThickness="1" ClipToBounds="True">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Top" Height="13" Background="#1B1917" CornerRadius="6,6,0,0">
                                                    <StackPanel Orientation="Horizontal" Margin="6,0" VerticalAlignment="Center">
                                                        <Ellipse Width="5" Height="5" Fill="{DynamicResource Gold}"/>
                                                        <Rectangle Width="22" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#ECE6DC" Margin="4,0,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <StackPanel Margin="7,7,7,0">
                                                    <Rectangle Height="4" RadiusX="2" RadiusY="2" Fill="#ECE6DC" Width="46" HorizontalAlignment="Left"/>
                                                    <Rectangle Height="4" RadiusX="2" RadiusY="2" Fill="#6B6259" Width="60" HorizontalAlignment="Left" Margin="0,5,0,0"/>
                                                    <Border Width="24" Height="9" CornerRadius="3" Background="{DynamicResource Gold}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <DockPanel Margin="2,8,0,0"><views:LucideIcon Kind="moon" Size="13" Margin="0,0,6,0"/><TextBlock Text="{loc:T settings.themeDark}"/></DockPanel>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="ThemeLight" Style="{StaticResource ChoiceTile}" GroupName="Theme" Tag="light" Checked="OnThemeChecked">
                                    <StackPanel>
                                        <Border Height="62" CornerRadius="7" Background="#F6F4F0" BorderBrush="#DAD5CE" BorderThickness="1" ClipToBounds="True">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Top" Height="13" Background="#FFFFFF" CornerRadius="6,6,0,0">
                                                    <StackPanel Orientation="Horizontal" Margin="6,0" VerticalAlignment="Center">
                                                        <Ellipse Width="5" Height="5" Fill="{DynamicResource Gold}"/>
                                                        <Rectangle Width="22" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#2E2A25" Margin="4,0,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <StackPanel Margin="7,7,7,0">
                                                    <Rectangle Height="4" RadiusX="2" RadiusY="2" Fill="#2E2A25" Width="46" HorizontalAlignment="Left"/>
                                                    <Rectangle Height="4" RadiusX="2" RadiusY="2" Fill="#A39A8F" Width="60" HorizontalAlignment="Left" Margin="0,5,0,0"/>
                                                    <Border Width="24" Height="9" CornerRadius="3" Background="{DynamicResource Gold}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <DockPanel Margin="2,8,0,0"><views:LucideIcon Kind="sun" Size="13" Margin="0,0,6,0"/><TextBlock Text="{loc:T settings.themeLight}"/></DockPanel>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="ThemeSystem" Style="{StaticResource ChoiceTile}" GroupName="Theme" Tag="system" Checked="OnThemeChecked">
                                    <StackPanel>
                                        <Grid>
                                            <Border Height="62" CornerRadius="7" Background="#131211" BorderBrush="#35302A" BorderThickness="1" ClipToBounds="True">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Top" Height="13" Background="#1B1917" CornerRadius="6,6,0,0">
                                                    <StackPanel Orientation="Horizontal" Margin="6,0" VerticalAlignment="Center">
                                                        <Ellipse Width="5" Height="5" Fill="{DynamicResource Gold}"/>
                                                        <Rectangle Width="22" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#ECE6DC" Margin="4,0,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <StackPanel Margin="7,7,7,0">
                                                    <Rectangle Height="4" RadiusX="2" RadiusY="2" Fill="#ECE6DC" Width="46" HorizontalAlignment="Left"/>
                                                    <Rectangle Height="4" RadiusX="2" RadiusY="2" Fill="#6B6259" Width="60" HorizontalAlignment="Left" Margin="0,5,0,0"/>
                                                    <Border Width="24" Height="9" CornerRadius="3" Background="{DynamicResource Gold}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                            <Grid>
                                                <Grid.Clip><RectangleGeometry Rect="78,0,300,62"/></Grid.Clip>
                                                <Border Height="62" CornerRadius="7" Background="#F6F4F0" BorderBrush="#DAD5CE" BorderThickness="1" ClipToBounds="True">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Top" Height="13" Background="#FFFFFF" CornerRadius="6,6,0,0">
                                                    <StackPanel Orientation="Horizontal" Margin="6,0" VerticalAlignment="Center">
                                                        <Ellipse Width="5" Height="5" Fill="{DynamicResource Gold}"/>
                                                        <Rectangle Width="22" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#2E2A25" Margin="4,0,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <StackPanel Margin="7,7,7,0">
                                                    <Rectangle Height="4" RadiusX="2" RadiusY="2" Fill="#2E2A25" Width="46" HorizontalAlignment="Left"/>
                                                    <Rectangle Height="4" RadiusX="2" RadiusY="2" Fill="#A39A8F" Width="60" HorizontalAlignment="Left" Margin="0,5,0,0"/>
                                                    <Border Width="24" Height="9" CornerRadius="3" Background="{DynamicResource Gold}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                            </Grid>
                                        </Grid>
                                        <DockPanel Margin="2,8,0,0"><views:LucideIcon Kind="monitor" Size="13" Margin="0,0,6,0"/><TextBlock Text="{loc:T settings.themeSystem}" TextTrimming="CharacterEllipsis"/></DockPanel>
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>

                            <TextBlock Text="{loc:T settings.backdrop}" Style="{StaticResource SectionTitle}" Margin="2,10,0,4"/>
                            <TextBlock x:Name="BackdropHint" Text="{loc:T settings.backdropHint}" Style="{StaticResource RowHint}" Margin="2,0,0,10"/>
                            <UniformGrid Columns="3" Margin="0,0,-8,6">
                                <RadioButton x:Name="BackdropNone" Style="{StaticResource ChoiceTile}" GroupName="Backdrop" Tag="none" Checked="OnBackdropChecked">
                                    <StackPanel>
                                        <Border Height="40" CornerRadius="7" Background="{DynamicResource c131211}" BorderBrush="{DynamicResource c35302A}" BorderThickness="1"/>
                                        <TextBlock Text="{loc:T settings.backdropNone}" Style="{StaticResource TileLabel}"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="BackdropMica" Style="{StaticResource ChoiceTile}" GroupName="Backdrop" Tag="mica" Checked="OnBackdropChecked">
                                    <StackPanel>
                                        <Border Height="40" CornerRadius="7" BorderBrush="{DynamicResource c35302A}" BorderThickness="1">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="{DynamicResource c2E2A26Color}" Offset="0"/>
                                                    <GradientStop Color="{DynamicResource c1B1917Color}" Offset="0.6"/>
                                                    <GradientStop Color="{DynamicResource GoldColor}" Offset="1.6"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock Text="Mica" Style="{StaticResource TileLabel}"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="BackdropAcrylic" Style="{StaticResource ChoiceTile}" GroupName="Backdrop" Tag="acrylic" Checked="OnBackdropChecked">
                                    <StackPanel>
                                        <Border Height="40" CornerRadius="7" BorderBrush="{DynamicResource c35302A}" BorderThickness="1" ClipToBounds="True">
                                            <Border.Background>
                                                <RadialGradientBrush GradientOrigin="0.2,0.3" Center="0.3,0.4" RadiusX="0.9" RadiusY="1.2">
                                                    <GradientStop Color="{DynamicResource GoldColor}" Offset="0"/>
                                                    <GradientStop Color="{DynamicResource c24211EColor}" Offset="0.7"/>
                                                </RadialGradientBrush>
                                            </Border.Background>
                                            <Border Background="{DynamicResource cB3131211}"/>
                                        </Border>
                                        <TextBlock Text="{loc:T settings.backdropAcrylic}" Style="{StaticResource TileLabel}"/>
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>

                            <DockPanel Margin="2,10,0,0">
                                <Button x:Name="ResetAccentButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Padding="12,6" Click="OnResetAccent"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <views:LucideIcon Kind="rotate-ccw" Size="13" Margin="0,0,7,0"/>
                                        <TextBlock Text="{loc:T settings.accentReset}" FontSize="12.5"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{loc:T settings.accent}" Style="{StaticResource RowTitle}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{loc:T settings.accentHint}" Style="{StaticResource RowHint}"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Row}" Margin="0,12,0,0">
                                <DockPanel>
                                    <CheckBox x:Name="SystemAccentSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="OnSystemAccentClick"/>
                                    <views:LucideIcon DockPanel.Dock="Left" Kind="monitor" Size="18" Margin="0,0,14,0" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource Gold}"/>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="{loc:T settings.accentSystem}" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="{loc:T settings.accentSystemHint}" Style="{StaticResource RowHint}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border x:Name="PickerRow" Style="{StaticResource Row}" Padding="18,16" Margin="0,0,0,0">
                                <views:AccentPicker x:Name="AccentPicker"/>
                            </Border>

                            <TextBlock Text="{loc:T settings.imageBackground}" Style="{StaticResource SectionTitle}" Margin="2,18,0,4"/>
                            <TextBlock Text="{loc:T settings.imageBackgroundHint}" Style="{StaticResource RowHint}" Margin="2,0,0,10"/>
                            <UniformGrid Columns="4" Margin="0,0,-8,0">
                                <RadioButton x:Name="ImageBgTheme" Style="{StaticResource ChoiceTile}" GroupName="ImageBg" Tag="theme" Checked="OnImageBgChecked">
                                    <StackPanel>
                                        <Border Height="34" CornerRadius="6" Background="{DynamicResource c131211}" BorderBrush="{DynamicResource c35302A}" BorderThickness="1"/>
                                        <TextBlock Text="{loc:T image.background.theme}" Style="{StaticResource TileLabel}"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="ImageBgChecker" Style="{StaticResource ChoiceTile}" GroupName="ImageBg" Tag="checker" Checked="OnImageBgChecked">
                                    <StackPanel>
                                        <Border x:Name="CheckerSample" Height="34" CornerRadius="6" BorderBrush="{DynamicResource c35302A}" BorderThickness="1"/>
                                        <TextBlock Text="{loc:T image.background.checker}" Style="{StaticResource TileLabel}"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="ImageBgBlack" Style="{StaticResource ChoiceTile}" GroupName="ImageBg" Tag="black" Checked="OnImageBgChecked">
                                    <StackPanel>
                                        <Border Height="34" CornerRadius="6" Background="Black" BorderBrush="{DynamicResource c35302A}" BorderThickness="1"/>
                                        <TextBlock Text="{loc:T image.background.black}" Style="{StaticResource TileLabel}"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="ImageBgWhite" Style="{StaticResource ChoiceTile}" GroupName="ImageBg" Tag="white" Checked="OnImageBgChecked">
                                    <StackPanel>
                                        <Border Height="34" CornerRadius="6" Background="White" BorderBrush="{DynamicResource c35302A}" BorderThickness="1"/>
                                        <TextBlock Text="{loc:T image.background.white}" Style="{StaticResource TileLabel}"/>
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>
                        </StackPanel>

                        <!-- Keys -->
                        <StackPanel x:Name="PageKeys" Visibility="Collapsed">
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="PreviewKeyField" Style="{StaticResource KeyField}" Click="OnRecordPreviewKey"/>
                                        <Button Style="{StaticResource IconButton}" Margin="6,0,0,0" Click="OnDisablePreviewKey" ToolTip="{loc:T settings.disable}">
                                            <views:LucideIcon Kind="x" Size="14"/>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="{loc:T settings.previewKey}" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="{loc:T settings.previewKeyHint}" Style="{StaticResource RowHint}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <TextBlock x:Name="KeyMessage" Text="{loc:T settings.recordHint}" FontSize="12.5" Foreground="{DynamicResource TextMuted}"
                                       TextWrapping="Wrap" Margin="2,4,0,16"/>

                            <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="OnRestoreKeys">
                                <StackPanel Orientation="Horizontal">
                                    <views:LucideIcon Kind="rotate-ccw" Size="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="{loc:T settings.restoreDefaults}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Updates -->
                        <StackPanel x:Name="PageUpdates" Visibility="Collapsed">
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <views:LucideIcon DockPanel.Dock="Left" Kind="download" Size="20" Margin="0,0,14,0" TextElement.Foreground="{DynamicResource Gold}"/>
                                    <StackPanel>
                                        <TextBlock x:Name="UpdatesVersionText" Style="{StaticResource RowTitle}"/>
                                        <TextBlock x:Name="UpdateStatusText" Style="{StaticResource RowHint}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <CheckBox x:Name="UpdatesSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="OnUpdatesClick"/>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="{loc:T settings.checkUpdates}" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="{loc:T settings.checkUpdatesHint}" Style="{StaticResource RowHint}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Button x:Name="CheckNowButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnCheckNow">
                                <StackPanel Orientation="Horizontal">
                                    <views:LucideIcon Kind="refresh-cw" Size="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="{loc:T settings.checkNow}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- About -->
                        <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                            <Border Style="{StaticResource Row}" Padding="22,22">
                                <DockPanel>
                                    <Image DockPanel.Dock="Left" Source="{DynamicResource AppLogo}" Width="64" Height="64" Margin="0,0,20,0"
                                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Top"/>
                                    <StackPanel>
                                        <TextBlock Text="Lupik" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock x:Name="AboutVersionText" FontSize="12.5" Foreground="{DynamicResource GoldHover}" Margin="0,2,0,10"/>
                                        <TextBlock Text="{loc:T settings.aboutText}" Style="{StaticResource RowHint}" FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnGitHub">
                                <StackPanel Orientation="Horizontal">
                                    <views:LucideIcon Kind="github" Size="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="{loc:T settings.github}"/>
                                    <views:LucideIcon Kind="external-link" Size="12" Margin="8,0,0,0" TextElement.Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Border>
</Window>
