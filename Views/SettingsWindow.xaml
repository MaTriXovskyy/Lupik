<Window x:Class="Lupik.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Lupik.Localization"
        xmlns:views="clr-namespace:Lupik.Views"
        Title="{loc:T settings.windowTitle}"
        Icon="pack://application:,,,/app.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Width="856" Height="636" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <!-- Left navigation -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="12,9">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#221F1C"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C2721"/>
                                <Setter Property="Foreground" Value="{StaticResource GoldHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- On/off switch -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="42" Height="24" CornerRadius="12" Background="#3B3631" Padding="3">
                            <Border x:Name="Knob" Width="18" Height="18" CornerRadius="9" Background="#B5AB9D" HorizontalAlignment="Left">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.35"/>
                                </Border.Effect>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Gold}"/>
                                <Setter TargetName="Knob" Property="Background" Value="{StaticResource OnGold}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Gold slider -->
        <Style x:Key="SliderEdge" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GoldSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22">
                            <Border Height="4" CornerRadius="2" Background="#3B3631" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderEdge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{StaticResource Gold}" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEdge}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="16" Height="16" Fill="{StaticResource GoldHover}" Stroke="#1B1917" StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One setting: text on the left, control on the right -->
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="Background" Value="#211E1B"/>
            <Setter Property="BorderBrush" Value="#2A2622"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Margin" Value="2,6,0,10"/>
        </Style>

        <!-- Language tile -->
        <!-- Must stay focusable: a ListBoxItem only gets selected on click if it can take the focus -->
        <Style x:Key="LangTile" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="#211E1B" BorderBrush="#2A2622" BorderThickness="1" CornerRadius="10" Padding="12,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#27231F"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B3631"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C2619"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Gold}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Field that records a key: click, then press the keys -->
        <Style x:Key="KeyField" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Foreground" Value="{StaticResource GoldHover}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#161412" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,8">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E1B18"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#3B3631"/>
        </Style>
    </Window.Resources>

    <!-- Margin leaves room for the shadow around the card -->
    <Border x:Name="Card" Margin="28" Background="#1B1917" BorderBrush="#35302A" BorderThickness="1" CornerRadius="16"
            RenderTransformOrigin="0.5,0.5" Opacity="0">
        <Border.RenderTransform>
            <ScaleTransform x:Name="CardScale" ScaleX="0.97" ScaleY="0.97"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="10" Direction="270" Opacity="0.55" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation -->
            <Border Background="#171513" CornerRadius="16,0,0,16" BorderBrush="#2A2622" BorderThickness="0,0,1,0"
                    MouseLeftButtonDown="OnDrag">
                <DockPanel Margin="14,20,14,16">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,22">
                        <Image Source="{StaticResource AppLogo}" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Lupik" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="{loc:T settings.title}" FontSize="11.5" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="VersionFooter" DockPanel.Dock="Bottom" FontSize="11" Foreground="#6B6259" Margin="8,0,0,0"/>
                    <StackPanel>
                        <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" IsChecked="True" Checked="OnNav">
                            <StackPanel Orientation="Horizontal">
                                <views:LucideIcon Kind="settings" Size="16" Margin="0,0,10,0"/>
                                <TextBlock Text="{loc:T settings.navGeneral}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavKeys" Style="{StaticResource NavItem}" Checked="OnNav">
                            <StackPanel Orientation="Horizontal">
                                <views:LucideIcon Kind="keyboard" Size="16" Margin="0,0,10,0"/>
                                <TextBlock Text="{loc:T settings.navKeys}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavUpdates" Style="{StaticResource NavItem}" Checked="OnNav">
                            <StackPanel Orientation="Horizontal">
                                <views:LucideIcon Kind="refresh-cw" Size="16" Margin="0,0,10,0"/>
                                <TextBlock Text="{loc:T settings.navUpdates}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Checked="OnNav">
                            <StackPanel Orientation="Horizontal">
                                <views:LucideIcon Kind="info" Size="16" Margin="0,0,10,0"/>
                                <TextBlock Text="{loc:T settings.navAbout}"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Pages -->
            <DockPanel Grid.Column="1">
                <Grid DockPanel.Dock="Top" Margin="28,18,14,6" Background="Transparent" MouseLeftButtonDown="OnDrag">
                    <TextBlock x:Name="PageTitle" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Click="OnClose" ToolTip="{loc:T common.closeEsc}">
                        <views:LucideIcon Kind="x" Size="16"/>
                    </Button>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,6,28,24">
                    <Grid>
                        <!-- General -->
                        <StackPanel x:Name="PageGeneral">
                            <TextBlock Text="{loc:T settings.language}" Style="{StaticResource SectionTitle}"/>
                            <ListBox x:Name="LanguageList" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,-8,6"
                                     ItemContainerStyle="{StaticResource LangTile}" SelectionChanged="OnLanguageSelected"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>

                            <TextBlock Text="{loc:T settings.behaviour}" Style="{StaticResource SectionTitle}" Margin="2,10,0,10"/>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <CheckBox x:Name="StartupSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="OnStartupClick"/>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="{loc:T settings.startup}" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="{loc:T settings.startupHint}" Style="{StaticResource RowHint}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <CheckBox x:Name="FocusLossSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="OnFocusLossClick"/>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="{loc:T settings.closeOnFocusLoss}" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="{loc:T settings.closeOnFocusLossHint}" Style="{StaticResource RowHint}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <CheckBox x:Name="AutoplaySwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="OnAutoplayClick"/>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="{loc:T settings.autoplay}" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="{loc:T settings.autoplayHint}" Style="{StaticResource RowHint}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock x:Name="ScaleText" DockPanel.Dock="Right" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource GoldHover}"/>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="{loc:T settings.windowSize}" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="{loc:T settings.windowSizeHint}" Style="{StaticResource RowHint}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <Slider x:Name="ScaleSlider" Style="{StaticResource GoldSlider}" Minimum="60" Maximum="100" SmallChange="5" LargeChange="10"
                                            TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,12,0,0" ValueChanged="OnScaleChanged"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Keys -->
                        <StackPanel x:Name="PageKeys" Visibility="Collapsed">
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="PreviewKeyField" Style="{StaticResource KeyField}" Click="OnRecordPreviewKey"/>
                                        <Button Style="{StaticResource IconButton}" Margin="6,0,0,0" Click="OnDisablePreviewKey" ToolTip="{loc:T settings.disable}">
                                            <views:LucideIcon Kind="x" Size="14"/>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="{loc:T settings.previewKey}" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="{loc:T settings.previewKeyHint}" Style="{StaticResource RowHint}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <TextBlock x:Name="KeyMessage" Text="{loc:T settings.recordHint}" FontSize="12.5" Foreground="{StaticResource TextMuted}"
                                       TextWrapping="Wrap" Margin="2,4,0,16"/>

                            <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="OnRestoreKeys">
                                <StackPanel Orientation="Horizontal">
                                    <views:LucideIcon Kind="rotate-ccw" Size="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="{loc:T settings.restoreDefaults}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Updates -->
                        <StackPanel x:Name="PageUpdates" Visibility="Collapsed">
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <views:LucideIcon DockPanel.Dock="Left" Kind="download" Size="20" Margin="0,0,14,0" TextElement.Foreground="{StaticResource Gold}"/>
                                    <StackPanel>
                                        <TextBlock x:Name="UpdatesVersionText" Style="{StaticResource RowTitle}"/>
                                        <TextBlock x:Name="UpdateStatusText" Style="{StaticResource RowHint}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <CheckBox x:Name="UpdatesSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="OnUpdatesClick"/>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="{loc:T settings.checkUpdates}" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="{loc:T settings.checkUpdatesHint}" Style="{StaticResource RowHint}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Button x:Name="CheckNowButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnCheckNow">
                                <StackPanel Orientation="Horizontal">
                                    <views:LucideIcon Kind="refresh-cw" Size="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="{loc:T settings.checkNow}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- About -->
                        <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                            <Border Style="{StaticResource Row}" Padding="22,22">
                                <DockPanel>
                                    <Image DockPanel.Dock="Left" Source="{StaticResource AppLogo}" Width="64" Height="64" Margin="0,0,20,0"
                                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Top"/>
                                    <StackPanel>
                                        <TextBlock Text="Lupik" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock x:Name="AboutVersionText" FontSize="12.5" Foreground="{StaticResource GoldHover}" Margin="0,2,0,10"/>
                                        <TextBlock Text="{loc:T settings.aboutText}" Style="{StaticResource RowHint}" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnGitHub">
                                <StackPanel Orientation="Horizontal">
                                    <views:LucideIcon Kind="github" Size="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="{loc:T settings.github}"/>
                                    <views:LucideIcon Kind="external-link" Size="12" Margin="8,0,0,0" TextElement.Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Border>
</Window>
