<UserControl x:Class="QuickPeek.Views.GenericViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:views="clr-namespace:QuickPeek.Views"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="600"
             Background="#18181B">
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32">
        <Border Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1"
                CornerRadius="12" Padding="32" Width="480">
            <StackPanel HorizontalAlignment="Center">
                <!-- Large File Icon -->
                <Image x:Name="FileIconImage" Width="80" Height="80" Margin="0,0,0,16"
                       HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- File Name -->
                <TextBlock x:Name="FileNameText" Text="plik.dat"
                           Foreground="#F4F4F5" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"/>

                <!-- File Type and Size -->
                <TextBlock x:Name="FileTypeAndSizeText" Text="Typ pliku • 4.2 MB"
                           Foreground="#A1A1AA" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,0,0,24"/>

                <!-- Metadata details table -->
                <Border Background="#18181B" CornerRadius="8" Padding="16" Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Zmodyfikowano:" Foreground="#71717A" FontSize="12" Margin="0,0,12,6"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ModifiedDateText" Text="2026-09-29 10:00" Foreground="#D4D4D8" FontSize="12" Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Utworzono:" Foreground="#71717A" FontSize="12" Margin="0,0,12,6"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CreatedDateText" Text="2026-09-28 15:30" Foreground="#D4D4D8" FontSize="12" Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Ścieżka:" Foreground="#71717A" FontSize="12" Margin="0,0,12,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="FilePathText" Text="C:\folder\plik.dat" Foreground="#D4D4D8" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>

                <!-- Open Action -->
                <Button
                        Background="#3B82F6" Foreground="#FFFFFF"
                        FontSize="13" FontWeight="SemiBold"
                        Padding="16,8" BorderThickness="0" Cursor="Hand"
                        HorizontalAlignment="Center"
                        Click="OnOpenClicked">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <views:LucideIcon Kind="square-arrow-out-up-right" Size="15" Margin="0,0,8,0"/>
                        <TextBlock Text="Otwórz w domyślnym programie" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
