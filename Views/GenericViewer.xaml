<UserControl x:Class="Lupik.Views.GenericViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Lupik.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:Lupik.Views"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="600"
             Background="{DynamicResource c131211}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32">
        <Border Background="{DynamicResource c24211E}" BorderBrush="{DynamicResource c3B3631}" BorderThickness="1"
                CornerRadius="12" Padding="32" Width="540">
            <StackPanel HorizontalAlignment="Stretch">
                <!-- Large File Icon -->
                <Image x:Name="FileIconImage" Width="80" Height="80" Margin="0,0,0,16"
                       HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- File Name -->
                <TextBlock x:Name="FileNameText" Text=""
                           Foreground="{DynamicResource cF6F1E9}" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"/>

                <!-- File Type and Size -->
                <TextBlock x:Name="FileTypeAndSizeText" Text=""
                           Foreground="{DynamicResource cB5AB9D}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                           HorizontalAlignment="Center" Margin="0,0,0,14"/>

                <!-- Badges: digital signature, downloaded from the internet -->
                <WrapPanel x:Name="Badges" HorizontalAlignment="Center" Margin="0,0,0,14"/>

                <!-- A font: a sample in it -->
                <Border x:Name="FontSampleBox" Background="{DynamicResource c131211}" CornerRadius="8" Padding="18,14" Margin="0,0,0,14" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="FontSampleBig" Text="Aa Bb Cc Ąą Źź" FontSize="38" Foreground="{DynamicResource cF6F1E9}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="FontSampleText" FontSize="16" Foreground="{DynamicResource cDDD6CB}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock x:Name="FontSampleDigits" Text="0123456789 !?&amp;@#%" FontSize="16" Foreground="{DynamicResource cB5AB9D}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Details: label / value rows, filled in code -->
                <Border Background="{DynamicResource c131211}" CornerRadius="8" Padding="16,14" Margin="0,0,0,24" Grid.IsSharedSizeScope="True">
                    <StackPanel x:Name="Rows"/>
                </Border>

                <!-- Actions -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="OpenWithButton" Style="{StaticResource PrimaryButton}" Click="OnOpenClicked">
                        <StackPanel Orientation="Horizontal">
                            <views:LucideIcon Kind="app-window" Size="15" Margin="0,0,8,0"/>
                            <TextBlock Text="{loc:T help.openWith}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="OpenTargetButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OnOpenTargetClicked" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <views:LucideIcon Kind="external-link" Size="14" Margin="0,0,8,0"/>
                            <TextBlock x:Name="OpenTargetText" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
