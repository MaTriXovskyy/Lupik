<UserControl x:Class="Lupik.Views.FontViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Lupik.Localization"
             xmlns:views="clr-namespace:Lupik.Views"
             Background="{DynamicResource c131211}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar: the family, its faces (a .ttc can hold several), how many characters it has -->
        <Border Grid.Row="0" Background="{DynamicResource c121110}" BorderBrush="{DynamicResource c2A2621}" BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Left" Background="{DynamicResource GoldTint}" BorderBrush="{DynamicResource GoldDeep}" BorderThickness="1" CornerRadius="10" Padding="9,2" Margin="0,0,12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" TextElement.Foreground="{DynamicResource Gold}">
                        <views:LucideIcon Kind="type" Size="12" Margin="0,0,5,0"/>
                        <TextBlock x:Name="FormatText" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="GlyphCountText" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="FamilyText" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource cF6F1E9}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FaceText" FontSize="12" Foreground="{DynamicResource cB5AB9D}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="28,22,28,28">
                <!-- The alphabet, big -->
                <TextBlock x:Name="AlphabetBig" FontSize="44" Foreground="{DynamicResource cF6F1E9}" TextWrapping="Wrap"
                           Text="ABCDEFGHIJKLMNOPQRSTUVWXYZ abcdefghijklmnopqrstuvwxyz 0123456789"/>

                <!-- The sample sentence at growing sizes -->
                <StackPanel x:Name="Sizes" Margin="0,22,0,0"/>

                <!-- Every character the font has -->
                <TextBlock Text="{loc:T font.characters}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Gold}" Margin="0,24,0,10"/>
                <WrapPanel x:Name="Glyphs"/>
                <TextBlock x:Name="GlyphsMore" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,8,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
