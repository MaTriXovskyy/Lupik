<UserControl x:Class="Lupik.Views.MediaViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Lupik.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:Lupik.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="{DynamicResource c131211}">
    <UserControl.Resources>
        <!-- Thin dark slider: filled part in the accent color, round thumb -->
        <Style x:Key="MediaSlider" TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="16" Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource c3B3631}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent">
                                                    <Border Height="4" CornerRadius="2" Background="{DynamicResource Gold}" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="12" Height="12" Fill="{DynamicResource cFBF8F2}"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Video (or the cover art for audio); click toggles play/pause -->
        <Grid Grid.Row="0" Background="Black" MouseLeftButtonUp="OnSurfaceClicked" Cursor="Hand">
            <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform"
                          MediaOpened="OnMediaOpened" MediaFailed="OnMediaFailed" MediaEnded="OnMediaEnded"/>

            <StackPanel x:Name="AudioPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="200" Height="200" CornerRadius="14" Background="{DynamicResource c24211E}" ClipToBounds="True">
                    <Grid>
                        <views:LucideIcon x:Name="AudioIcon" Kind="music" Size="72" StrokeWidth="1.5"
                                          HorizontalAlignment="Center" TextElement.Foreground="{DynamicResource Gold}"/>
                        <Image x:Name="CoverImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="AudioTitleText" Foreground="{DynamicResource cFBF8F2}" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,0"
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="440"/>
            </StackPanel>
        </Grid>

        <!-- Transport bar -->
        <Border Grid.Row="1" Background="{DynamicResource c1B1917}" BorderBrush="{DynamicResource c2F2B27}" BorderThickness="0,1,0,0" Padding="8,0,12,0" Height="44">
            <DockPanel VerticalAlignment="Center">
                <Button x:Name="PlayButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}" ToolTip="{loc:T media.playTip}" Click="OnPlayClicked">
                    <views:LucideIcon x:Name="PlayIcon" Kind="pause" Size="16"/>
                </Button>
                <TextBlock x:Name="TimeText" DockPanel.Dock="Left" Text="0:00 / 0:00" Foreground="{DynamicResource cB5AB9D}" FontSize="12"
                           VerticalAlignment="Center" Margin="6,0,12,0" MinWidth="84"/>

                <Slider x:Name="VolumeSlider" DockPanel.Dock="Right" Style="{StaticResource MediaSlider}" Width="80"
                        Minimum="0" Maximum="1" Value="0.8" ValueChanged="OnVolumeChanged"/>
                <Button x:Name="MuteButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="{loc:T media.muteTip}" Click="OnMuteClicked" Margin="12,0,4,0">
                    <views:LucideIcon x:Name="MuteIcon" Kind="volume-2" Size="16"/>
                </Button>
                <TextBlock DockPanel.Dock="Right" Text="J / L  ±5 s" Foreground="{DynamicResource c5A534B}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>

                <Slider x:Name="SeekSlider" Style="{StaticResource MediaSlider}" Minimum="0" Maximum="1"
                        ValueChanged="OnSeekChanged"/>
            </DockPanel>
        </Border>

        <!-- Edit mode (E): the timeline with the start / end handles and the parts cut out, and its buttons -->
        <Border x:Name="EditStrip" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource c181614}"
                BorderBrush="{DynamicResource c2F2B27}" BorderThickness="0,1,0,0" Padding="14,10,14,10">
            <StackPanel>
                <Canvas x:Name="Timeline" Height="46" Background="Transparent" Cursor="IBeam"
                        MouseLeftButtonDown="OnTimelineDown" MouseMove="OnTimelineMove" MouseLeftButtonUp="OnTimelineUp" SizeChanged="OnTimelineSizeChanged"/>
                <DockPanel Margin="0,10,0,0">
                    <TextBlock x:Name="EditInfoText" DockPanel.Dock="Right" Foreground="{DynamicResource cB5AB9D}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <WrapPanel>
                        <Button Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="12" Margin="0,0,6,0" Click="OnSetStartClicked">
                            <StackPanel Orientation="Horizontal"><views:LucideIcon Kind="chevron-first" Size="14" Margin="0,0,6,0"/><TextBlock Text="{loc:T mediaEdit.start}" VerticalAlignment="Center"/><Border Style="{StaticResource KeyHint}"><TextBlock Text="I" FontSize="10.5" Foreground="{DynamicResource cB5AB9D}"/></Border></StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="12" Margin="0,0,6,0" Click="OnSetEndClicked">
                            <StackPanel Orientation="Horizontal"><views:LucideIcon Kind="chevron-last" Size="14" Margin="0,0,6,0"/><TextBlock Text="{loc:T mediaEdit.end}" VerticalAlignment="Center"/><Border Style="{StaticResource KeyHint}"><TextBlock Text="O" FontSize="10.5" Foreground="{DynamicResource cB5AB9D}"/></Border></StackPanel>
                        </Button>
                        <Button x:Name="CutButton" Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="12" Margin="0,0,6,0" Click="OnCutClicked">
                            <StackPanel Orientation="Horizontal"><views:LucideIcon Kind="scissors" Size="14" Margin="0,0,6,0"/><TextBlock Text="{loc:T mediaEdit.cut}" VerticalAlignment="Center"/><Border Style="{StaticResource KeyHint}"><TextBlock Text="Del" FontSize="10.5" Foreground="{DynamicResource cB5AB9D}"/></Border></StackPanel>
                        </Button>
                        <Button x:Name="UndoCutButton" Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="12" Margin="0" Click="OnUndoCutClicked">
                            <StackPanel Orientation="Horizontal"><views:LucideIcon Kind="undo-2" Size="14" Margin="0,0,6,0"/><TextBlock Text="{loc:T mediaEdit.undo}" VerticalAlignment="Center"/><Border Style="{StaticResource KeyHint}"><TextBlock Text="Ctrl+Z" FontSize="10.5" Foreground="{DynamicResource cB5AB9D}"/></Border></StackPanel>
                        </Button>
                    </WrapPanel>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
