<UserControl x:Class="Lupik.Views.DocxViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Lupik.Views"
             Background="{DynamicResource c131211}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource c1B1917}" BorderBrush="{DynamicResource c2F2B27}" BorderThickness="0,0,0,1" Padding="14,8">
            <StackPanel Orientation="Horizontal">
                <Border Background="{DynamicResource c1E2F45}" BorderBrush="{DynamicResource c2F4A6E}" BorderThickness="1" CornerRadius="10" Padding="9,2" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" TextElement.Foreground="{DynamicResource c8CB8F0}">
                        <views:LucideIcon Kind="file-text" Size="12" Margin="0,0,5,0"/>
                        <TextBlock x:Name="BadgeText" Text="DOCX" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="SummaryText" Foreground="{DynamicResource cB5AB9D}" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- The document as one long sheet of paper, centered on the dark background -->
        <ScrollViewer Grid.Row="1" x:Name="PageScroller" Focusable="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,24,0,32" HorizontalAlignment="Center">
                <Border Background="White" CornerRadius="2">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.45" Color="Black"/>
                    </Border.Effect>
                </Border>
                <!-- The page margins are the RichTextBox's padding (it overrides the document's own PagePadding) -->
                <RichTextBox x:Name="Page" Width="816" IsReadOnly="True" IsDocumentEnabled="True" Focusable="False"
                             Background="White" BorderThickness="0" Padding="80,60,80,64" Cursor="Arrow"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
