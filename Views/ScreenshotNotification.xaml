<Window x:Class="Lupik.Views.ScreenshotNotification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Lupik.Views" xmlns:loc="clr-namespace:Lupik.Localization"
        Title="Lupik" Width="380" Height="300" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True" AllowsTransparency="True" Background="Transparent" Focusable="False">
    <Border Margin="12" Background="{DynamicResource c1B1917}" BorderBrush="{DynamicResource c35302A}" BorderThickness="1" CornerRadius="13">
        <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" Color="Black"/></Border.Effect>
        <Grid>
            <Button x:Name="OpenButton" Click="OnOpen" Background="Transparent" BorderThickness="0" Cursor="Hand" Focusable="False" IsTabStop="False">
                <Button.Template><ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate></Button.Template>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition/><RowDefinition Height="54"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="14,0,42,0" VerticalAlignment="Center">
                        <Image Source="{DynamicResource AppLogo}" Width="30" Height="30"/>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="Lupik" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="StatusText" FontSize="11.5" Foreground="{DynamicResource TextMuted}"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Row="1" Background="{DynamicResource Surface}" Margin="12,0" CornerRadius="5" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="Thumbnail" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="TextPreview" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" FontSize="12" Margin="10" ClipToBounds="True"/>
                        </Grid>
                    </Border>
                    <DockPanel Grid.Row="2" Margin="15,0" VerticalAlignment="Center">
                        <views:LucideIcon DockPanel.Dock="Right" Kind="external-link" Size="16" TextElement.Foreground="{DynamicResource Gold}"/>
                        <StackPanel>
                            <TextBlock x:Name="ActionText" Text="{loc:T capture.openPreview}" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="DimensionsText" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Button>
            <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="7" Click="OnDismiss" Focusable="False" IsTabStop="False">
                <views:LucideIcon Kind="x" Size="14"/>
            </Button>
        </Grid>
    </Border>
</Window>
