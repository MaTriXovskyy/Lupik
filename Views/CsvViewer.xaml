<UserControl x:Class="QuickPeek.Views.CsvViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:QuickPeek.Views"
             Background="#131211">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1B1917" BorderBrush="#2F2B27" BorderThickness="0,0,0,1" Padding="14,8">
            <StackPanel Orientation="Horizontal">
                <Border Background="#1F3A2B" BorderBrush="#2F5E43" BorderThickness="1" CornerRadius="10" Padding="9,2" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" TextElement.Foreground="#A6E3A1">
                        <views:LucideIcon Kind="sheet" Size="12" Margin="0,0,5,0"/>
                        <TextBlock Text="CSV" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="SummaryText" Foreground="#B5AB9D" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Pixel scrolling (CanContentScroll=False); the table draws only what's in view -->
        <ScrollViewer Grid.Row="1" x:Name="TableScroller" CanContentScroll="False" Focusable="False"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <views:CsvTable x:Name="Table" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        </ScrollViewer>
    </Grid>
</UserControl>
