<UserControl x:Class="Lupik.Views.AccentPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Lupik.Localization"
             xmlns:views="clr-namespace:Lupik.Views">
    <UserControl.Resources>
        <!-- Ready-made color: a dot in a ring that lights up when it's the current color -->
        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="38" Height="38" Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="2"/>
                            <Ellipse x:Name="Dot" Width="26" Height="26" Fill="{TemplateBinding Background}" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="DotScale"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <views:LucideIcon x:Name="Tick" Kind="check" Size="14" StrokeWidth="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource c4A433B}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource TextPrimary}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Number / hex field -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Gold}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Gold}"/>
            <Setter Property="SelectionOpacity" Value="0.35"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource c161412}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource c3B3631}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,6"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Gold}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Margin" Value="2,0,0,5"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Ready-made colors -->
        <ItemsControl x:Name="Presets" Margin="-6,0,0,14">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="188"/>
            </Grid.ColumnDefinitions>

            <!-- Saturation (→) and brightness (↑) of the chosen hue, then the hue itself -->
            <StackPanel Margin="0,0,20,0">
                <Grid x:Name="Field" Height="168" Cursor="Cross" SizeChanged="OnFieldSized"
                      MouseLeftButtonDown="OnFieldDown" MouseMove="OnFieldMove" MouseLeftButtonUp="OnFieldUp" LostMouseCapture="OnLostCapture">
                    <Grid x:Name="FieldColors">
                    <Rectangle x:Name="HueFill"/>
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="White" Offset="0"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="Black" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    </Grid>
                    <Border BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="10" IsHitTestVisible="False"/>
                    <Canvas IsHitTestVisible="False" ClipToBounds="False">
                        <Ellipse x:Name="FieldThumb" Width="18" Height="18" Stroke="White" StrokeThickness="2.5">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.6"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Canvas>
                </Grid>

                <Grid x:Name="HueBar" Height="14" Margin="0,14,0,0" Cursor="Hand"
                      MouseLeftButtonDown="OnHueDown" MouseMove="OnHueMove" MouseLeftButtonUp="OnHueUp" LostMouseCapture="OnLostCapture">
                    <Border CornerRadius="7">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF0000" Offset="0"/>
                                <GradientStop Color="#FFFF00" Offset="0.1667"/>
                                <GradientStop Color="#00FF00" Offset="0.3333"/>
                                <GradientStop Color="#00FFFF" Offset="0.5"/>
                                <GradientStop Color="#0000FF" Offset="0.6667"/>
                                <GradientStop Color="#FF00FF" Offset="0.8333"/>
                                <GradientStop Color="#FF0000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Canvas IsHitTestVisible="False">
                        <Ellipse x:Name="HueThumb" Width="20" Height="20" Canvas.Top="-3" Stroke="White" StrokeThickness="3">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.6"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Canvas>
                </Grid>
            </StackPanel>

            <!-- The result (the logo in the new color) and exact values -->
            <StackPanel Grid.Column="1">
                <Border CornerRadius="12" Background="{DynamicResource c161412}" BorderBrush="{DynamicResource c2A2622}" BorderThickness="1" Padding="12" Margin="0,0,0,12">
                    <DockPanel>
                        <Image Source="{DynamicResource AppLogo}" Width="44" Height="44" DockPanel.Dock="Left" Margin="0,0,12,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ColorName" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource GoldHover}"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="ColorHex" FontSize="11.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"
                                       FontFamily="Cascadia Mono, Consolas"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBlock Text="HEX" Style="{StaticResource FieldLabel}"/>
                <Border Style="{StaticResource FieldBox}" Margin="0,0,0,10">
                    <DockPanel>
                        <TextBlock Text="#" DockPanel.Dock="Left" FontSize="13" FontFamily="Cascadia Mono, Consolas"
                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,2,0"/>
                        <TextBox x:Name="HexBox" Style="{StaticResource Field}" MaxLength="6" CharacterCasing="Upper"
                                 KeyDown="OnFieldKey" LostKeyboardFocus="OnHexCommit"/>
                    </DockPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="R" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource FieldBox}" Padding="8,6">
                            <TextBox x:Name="RBox" Style="{StaticResource Field}" MaxLength="3" KeyDown="OnFieldKey" LostKeyboardFocus="OnRgbCommit"
                                     PreviewMouseWheel="OnRgbWheel"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="G" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource FieldBox}" Padding="8,6">
                            <TextBox x:Name="GBox" Style="{StaticResource Field}" MaxLength="3" KeyDown="OnFieldKey" LostKeyboardFocus="OnRgbCommit"
                                     PreviewMouseWheel="OnRgbWheel"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="B" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource FieldBox}" Padding="8,6">
                            <TextBox x:Name="BBox" Style="{StaticResource Field}" MaxLength="3" KeyDown="OnFieldKey" LostKeyboardFocus="OnRgbCommit"
                                     PreviewMouseWheel="OnRgbWheel"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Too dark to read as text on Lupik's background: say what is used instead -->
        <DockPanel x:Name="LiftNote" Margin="0,14,0,0" Visibility="Collapsed">
            <views:LucideIcon DockPanel.Dock="Left" Kind="info" Size="14" Margin="0,1,8,0" VerticalAlignment="Top" TextElement.Foreground="{DynamicResource GoldPressed}"/>
            <TextBlock x:Name="LiftText" FontSize="12" Foreground="{DynamicResource GoldPressed}" TextWrapping="Wrap"/>
        </DockPanel>
    </StackPanel>
</UserControl>
