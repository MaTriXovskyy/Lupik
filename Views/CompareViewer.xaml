<UserControl x:Class="Lupik.Views.CompareViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Lupik.Views"
             Background="#131211" ClipToBounds="True">
    <UserControl.Resources>
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Background" Value="#CC131211"/>
            <Setter Property="BorderBrush" Value="#3B3631"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style x:Key="ModeButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="Viewport" Background="Transparent" ClipToBounds="True"
                MouseWheel="OnMouseWheel" MouseLeftButtonDown="OnMouseDown" MouseLeftButtonUp="OnMouseUp" MouseMove="OnMouseMove">
            <Grid>
                <!-- Side by side: both panes share one zoom/pan transform -->
                <Grid x:Name="SideBySide">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="PaneA" ClipToBounds="True">
                        <Image x:Name="SideImageA" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="6"/>
                        <Border Style="{StaticResource Badge}" HorizontalAlignment="Left">
                            <TextBlock x:Name="SideLabelA" Foreground="#ECE6DC" FontSize="11.5"/>
                        </Border>
                    </Grid>
                    <Rectangle Grid.Column="1" Fill="#2F2B27"/>
                    <Grid x:Name="PaneB" Grid.Column="2" ClipToBounds="True">
                        <Image x:Name="SideImageB" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="6"/>
                        <Border Style="{StaticResource Badge}" HorizontalAlignment="Left">
                            <TextBlock x:Name="SideLabelB" Foreground="#ECE6DC" FontSize="11.5"/>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Slider: B drawn over A, clipped right of the split line -->
                <Grid x:Name="SliderMode" Visibility="Collapsed">
                    <Image x:Name="SliderImageA" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="6"/>
                    <Grid x:Name="SliderClipB">
                        <Image x:Name="SliderImageB" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="6"/>
                    </Grid>
                    <Canvas IsHitTestVisible="False">
                        <Rectangle x:Name="SplitLine" Width="2" Fill="#F6F1E9" Opacity="0.9"/>
                        <Border x:Name="SplitHandle" Width="30" Height="30" CornerRadius="15" Background="#F6F1E9">
                            <views:LucideIcon Kind="arrow-left-right" Size="15" TextElement.Foreground="#131211"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Canvas>
                    <Border Style="{StaticResource Badge}" HorizontalAlignment="Left">
                        <TextBlock x:Name="SliderLabelA" Foreground="#ECE6DC" FontSize="11.5"/>
                    </Border>
                    <Border Style="{StaticResource Badge}" HorizontalAlignment="Right">
                        <TextBlock x:Name="SliderLabelB" Foreground="#ECE6DC" FontSize="11.5"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="1" Background="#1B1917" BorderBrush="#2F2B27" BorderThickness="0,1,0,0" Padding="12,0" Height="36">
            <DockPanel LastChildFill="False" VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="InfoTextA" Foreground="#B5AB9D" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="  vs  " Foreground="#5A534B" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="InfoTextB" Foreground="#B5AB9D" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SideButton" Style="{StaticResource ModeButton}" ToolTip="Obok siebie (S)" Click="OnSideClicked">
                        <StackPanel Orientation="Horizontal">
                            <views:LucideIcon Kind="columns-2" Size="15" Margin="0,0,6,0"/>
                            <TextBlock Text="Obok siebie" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SliderButton" Style="{StaticResource ModeButton}" ToolTip="Suwak przed/po (S)" Click="OnSliderClicked">
                        <StackPanel Orientation="Horizontal">
                            <views:LucideIcon Kind="square-split-horizontal" Size="15" Margin="0,0,6,0"/>
                            <TextBlock Text="Suwak" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="Zamień strony (X)" Click="OnSwapClicked">
                        <views:LucideIcon Kind="arrow-left-right" Size="15"/>
                    </Button>

                    <Rectangle Width="1" Height="16" Fill="#3B3631" Margin="8,0"/>

                    <Button Style="{StaticResource IconButton}" ToolTip="Pomniejsz" Click="OnZoomOutClicked">
                        <views:LucideIcon Kind="zoom-out" Size="15"/>
                    </Button>
                    <TextBlock x:Name="ZoomText" Text="100%" Foreground="#E3B341" FontSize="12" FontWeight="Medium"
                               Width="44" TextAlignment="Center" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource IconButton}" ToolTip="Powiększ" Click="OnZoomInClicked">
                        <views:LucideIcon Kind="zoom-in" Size="15"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="Dopasuj (0)" Click="OnFitClicked">
                        <views:LucideIcon Kind="scan" Size="15"/>
                    </Button>

                    <Rectangle Width="1" Height="16" Fill="#3B3631" Margin="8,0"/>

                    <Button Style="{StaticResource IconButton}" ToolTip="Pojedynczo (C)" Click="OnSingleClicked">
                        <views:LucideIcon Kind="image" Size="15"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
