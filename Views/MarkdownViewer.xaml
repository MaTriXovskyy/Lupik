<UserControl x:Class="Lupik.Views.MarkdownViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Lupik.Localization"
             xmlns:views="clr-namespace:Lupik.Views"
             Background="{DynamicResource c131211}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar: like the code view's, with the switch to the source -->
        <Border Grid.Row="0" Background="{DynamicResource c121110}" BorderBrush="{DynamicResource c2A2621}" BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border Background="{DynamicResource GoldTint}" BorderBrush="{DynamicResource GoldDeep}" BorderThickness="1" CornerRadius="10" Padding="9,2" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" TextElement.Foreground="{DynamicResource Gold}">
                            <views:LucideIcon Kind="file-text" Size="12" Margin="0,0,5,0"/>
                            <TextBlock Text="MARKDOWN" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="SummaryText" Foreground="{DynamicResource c7F849C}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Click="OnCodeClicked" ToolTip="{loc:T markdown.codeTip}">
                    <StackPanel Orientation="Horizontal">
                        <views:LucideIcon Kind="code" Size="14" Margin="0,0,6,0"/>
                        <TextBlock Text="{loc:T markdown.code}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <!-- The document, in a readable column -->
        <ScrollViewer Grid.Row="1" x:Name="PageScroller" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <RichTextBox x:Name="Page" MaxWidth="860" Margin="28,22,28,36" IsReadOnly="True" IsDocumentEnabled="True" Focusable="False"
                         Background="Transparent" BorderThickness="0" Padding="0" Cursor="Arrow"
                         Foreground="{DynamicResource cE9E2D6}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14.5"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        </ScrollViewer>
    </Grid>
</UserControl>
