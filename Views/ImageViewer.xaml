<UserControl x:Class="QuickPeek.Views.ImageViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:QuickPeek.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#18181B"
             ClipToBounds="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Interactive Image Canvas -->
        <Border x:Name="ViewportBorder" Grid.Row="0" Background="Transparent" ClipToBounds="True"
                MouseWheel="OnMouseWheel"
                MouseLeftButtonDown="OnMouseLeftButtonDown"
                MouseLeftButtonUp="OnMouseLeftButtonUp"
                MouseMove="OnMouseMove">
            <Image x:Name="PreviewImage"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   RenderOptions.EdgeMode="Aliased">
                <!-- Rotation as a layout transform, so a rotated image still fits the viewport -->
                <Image.LayoutTransform>
                    <RotateTransform x:Name="ImageRotation" Angle="0"/>
                </Image.LayoutTransform>
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="ImageTranslate" X="0" Y="0" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
        </Border>

        <!-- Info panel (I): slides up from the footer, height animated from 0 -->
        <Border x:Name="InfoPanel" Grid.Row="1" Height="0" ClipToBounds="True" Background="#1B1B1F"
                BorderBrush="#2E2E33" BorderThickness="0,1,0,0">
            <ItemsControl x:Name="InfoItems" VerticalAlignment="Top" Margin="12,10,12,8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,26,8" MinWidth="110" MaxWidth="340">
                            <TextBlock Text="{Binding Label}" Foreground="#71717A" FontSize="10.5" FontWeight="SemiBold"/>
                            <TextBlock x:Name="Value" Text="{Binding Value}" Foreground="#E4E4E7" FontSize="12.5" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}"/>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Accent}" Value="True">
                                <Setter TargetName="Value" Property="Foreground" Value="#CBA6F7"/>
                                <Setter TargetName="Value" Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Footer: never covers the image -->
        <Border Grid.Row="2" Background="#1F1F23" BorderBrush="#2E2E33" BorderThickness="0,1,0,0" Padding="12,0" Height="36">
            <DockPanel LastChildFill="False" VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="InfoButton" Style="{StaticResource IconButton}" ToolTip="Informacje o obrazie (I)"
                            Click="OnInfoClicked" Margin="-6,0,4,0">
                        <views:LucideIcon Kind="info" Size="15"/>
                    </Button>
                    <TextBlock x:Name="DimensionsText" Text="1920 × 1080 px"
                               Foreground="#F4F4F5" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Ellipse Width="3" Height="3" Fill="#52525B" Margin="9,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FileSizeText" Text="2.4 MB" Foreground="#A1A1AA" FontSize="12" VerticalAlignment="Center"/>
                    <Ellipse Width="3" Height="3" Fill="#52525B" Margin="9,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FormatText" Text="PNG" Foreground="#A1A1AA" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" ToolTip="Pomniejsz" Click="OnZoomOutClicked">
                        <views:LucideIcon Kind="zoom-out" Size="15"/>
                    </Button>
                    <TextBlock x:Name="ZoomText" Text="100%" Foreground="#38BDF8" FontSize="12" FontWeight="Medium"
                               Width="44" TextAlignment="Center" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource IconButton}" ToolTip="Powiększ" Click="OnZoomInClicked">
                        <views:LucideIcon Kind="zoom-in" Size="15"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="Dopasuj (0)" Click="OnResetZoomClicked">
                        <views:LucideIcon Kind="scan" Size="15"/>
                    </Button>

                    <Rectangle Width="1" Height="16" Fill="#3F3F46" Margin="8,0"/>

                    <Button Style="{StaticResource IconButton}" ToolTip="Obróć w lewo (Shift+R)" Click="OnRotateLeftClicked">
                        <views:LucideIcon Kind="rotate-ccw" Size="15"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="Obróć w prawo (R)" Click="OnRotateRightClicked">
                        <views:LucideIcon Kind="rotate-cw" Size="15"/>
                    </Button>

                    <Rectangle Width="1" Height="16" Fill="#3F3F46" Margin="8,0"/>

                    <Button x:Name="CopyImageButton" Style="{StaticResource IconButton}" ToolTip="Kopiuj obraz do schowka (Ctrl+C)" Click="OnCopyImageClicked">
                        <views:LucideIcon x:Name="CopyImageIcon" Kind="clipboard-copy" Size="15"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
