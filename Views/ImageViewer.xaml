<UserControl x:Class="Lupik.Views.ImageViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Lupik.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:Lupik.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#131211"
             ClipToBounds="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Interactive Image Canvas -->
        <Border x:Name="ViewportBorder" Grid.Row="0" Background="Transparent" ClipToBounds="True"
                MouseWheel="OnMouseWheel"
                MouseLeftButtonDown="OnMouseLeftButtonDown"
                MouseLeftButtonUp="OnMouseLeftButtonUp"
                MouseMove="OnMouseMove">
            <Image x:Name="PreviewImage"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   RenderOptions.EdgeMode="Aliased">
                <!-- Rotation as a layout transform, so a rotated image still fits the viewport -->
                <Image.LayoutTransform>
                    <RotateTransform x:Name="ImageRotation" Angle="0"/>
                </Image.LayoutTransform>
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="ImageTranslate" X="0" Y="0" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
        </Border>

        <!-- Crop mode: dimmed surroundings, gold frame with corner handles -->
        <Canvas x:Name="CropLayer" Grid.Row="0" Background="Transparent" Visibility="Collapsed" ClipToBounds="True" Cursor="Cross"
                MouseLeftButtonDown="OnCropMouseDown" MouseMove="OnCropMouseMove" MouseLeftButtonUp="OnCropMouseUp" SizeChanged="OnCropLayerSizeChanged">
            <Path x:Name="CropShade" Fill="#A6000000" IsHitTestVisible="False"/>
            <Rectangle x:Name="CropFrame" Stroke="#E3B341" StrokeThickness="1.5" IsHitTestVisible="False"/>
            <!-- Handles: big corners, bars in the middle of each edge (the whole edge can be dragged) -->
            <Rectangle x:Name="HandleTL" Width="20" Height="20" Fill="#E3B341" Stroke="#1A1407" StrokeThickness="2" RadiusX="4" RadiusY="4" IsHitTestVisible="False"/>
            <Rectangle x:Name="HandleTR" Width="20" Height="20" Fill="#E3B341" Stroke="#1A1407" StrokeThickness="2" RadiusX="4" RadiusY="4" IsHitTestVisible="False"/>
            <Rectangle x:Name="HandleBL" Width="20" Height="20" Fill="#E3B341" Stroke="#1A1407" StrokeThickness="2" RadiusX="4" RadiusY="4" IsHitTestVisible="False"/>
            <Rectangle x:Name="HandleBR" Width="20" Height="20" Fill="#E3B341" Stroke="#1A1407" StrokeThickness="2" RadiusX="4" RadiusY="4" IsHitTestVisible="False"/>
            <Rectangle x:Name="HandleT" Width="34" Height="10" Fill="#E3B341" Stroke="#1A1407" StrokeThickness="2" RadiusX="4" RadiusY="4" IsHitTestVisible="False"/>
            <Rectangle x:Name="HandleB" Width="34" Height="10" Fill="#E3B341" Stroke="#1A1407" StrokeThickness="2" RadiusX="4" RadiusY="4" IsHitTestVisible="False"/>
            <Rectangle x:Name="HandleL" Width="10" Height="34" Fill="#E3B341" Stroke="#1A1407" StrokeThickness="2" RadiusX="4" RadiusY="4" IsHitTestVisible="False"/>
            <Rectangle x:Name="HandleR" Width="10" Height="34" Fill="#E3B341" Stroke="#1A1407" StrokeThickness="2" RadiusX="4" RadiusY="4" IsHitTestVisible="False"/>
            <Border x:Name="CropHint" Background="#E61B1917" BorderBrush="#3B3631" BorderThickness="1" CornerRadius="8" Padding="12,6" IsHitTestVisible="False">
                <TextBlock x:Name="CropHintText" Foreground="#ECE6DC" FontSize="12">
                    <Run x:Name="CropSizeRun" Text="" Foreground="#F0C95E" FontWeight="SemiBold"/><Run Text="   "/><Run Text="{loc:T crop.modifiers}" Foreground="#B5AB9D"/>
                    <Run Text="   Enter" Foreground="#F0C95E" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{loc:T crop.save}"/>
                    <Run Text="   Esc" Foreground="#F0C95E" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{loc:T crop.cancel}"/>
                </TextBlock>
            </Border>
        </Canvas>

        <!-- Info panel (I): slides up from the footer, height animated from 0 -->
        <Border x:Name="InfoPanel" Grid.Row="1" Height="0" ClipToBounds="True" Background="#181614"
                BorderBrush="#2F2B27" BorderThickness="0,1,0,0">
            <ItemsControl x:Name="InfoItems" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="12,8,12,4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="11,0,11,6" MaxWidth="340">
                            <TextBlock Text="{Binding Label}" Foreground="#8A8074" FontSize="10.5" FontWeight="SemiBold"/>
                            <TextBlock x:Name="Value" Text="{Binding Value}" Foreground="#ECE6DC" FontSize="12.5" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}"/>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Accent}" Value="True">
                                <Setter TargetName="Value" Property="Foreground" Value="#E3B341"/>
                                <Setter TargetName="Value" Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Filmstrip (T): the folder's images; click one to show it. Thumbnails load only as they come into view -->
        <Border x:Name="Filmstrip" Grid.Row="2" Height="{x:Static views:ImageViewer.FilmstripHeight}" Background="#161412"
                BorderBrush="#2F2B27" BorderThickness="0,1,0,0" Visibility="Collapsed">
            <ListBox x:Name="FilmstripList" Background="Transparent" BorderThickness="0" Padding="8,0" Focusable="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel" PreviewMouseWheel="OnFilmstripWheel">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Width="76" Height="60" Margin="3,0" CornerRadius="6" BorderThickness="2"
                                            BorderBrush="Transparent" Background="#1F1C19" ToolTip="{Binding Name}"
                                            Loaded="OnFilmstripItemLoaded" MouseLeftButtonUp="OnFilmstripItemClicked">
                                        <Border CornerRadius="4" ClipToBounds="True">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#5A534B"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#E3B341"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <!-- Footer: never covers the image -->
        <Border x:Name="Footer" Grid.Row="3" Background="#1B1917" BorderBrush="#2F2B27" BorderThickness="0,1,0,0" Padding="12,0" Height="36">
            <Grid x:Name="FooterGrid" SizeChanged="OnFooterLayoutChanged">
            <!-- Key hints, centered in the footer; hidden when they'd run into the side groups (narrow window) -->
            <StackPanel x:Name="FooterHints" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="#8A8074">
                <StackPanel.Resources>
                    <Style x:Key="Cap" TargetType="Border">
                        <Setter Property="BorderBrush" Value="#3B3631"/>
                        <Setter Property="BorderThickness" Value="1,1,1,2"/>
                        <Setter Property="CornerRadius" Value="4"/>
                        <Setter Property="Padding" Value="5,0,5,1"/>
                        <Setter Property="Margin" Value="0,0,3,0"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </StackPanel.Resources>
                <Border Style="{StaticResource Cap}"><TextBlock Text="←" FontSize="10.5" Foreground="#B5AB9D"/></Border>
                <Border Style="{StaticResource Cap}"><TextBlock Text="→" FontSize="10.5" Foreground="#B5AB9D"/></Border>
                <TextBlock Text="{loc:T hint.prevNext}" FontSize="11" VerticalAlignment="Center" Margin="3,0,18,0"/>
                <Border Style="{StaticResource Cap}"><TextBlock Text="{loc:T key.preview}" FontSize="10.5" Foreground="#B5AB9D"/></Border>
                <TextBlock Text="{loc:T hint.close}" FontSize="11" VerticalAlignment="Center" Margin="3,0,0,0"/>
            </StackPanel>
            <DockPanel LastChildFill="False" VerticalAlignment="Center">
                <StackPanel x:Name="FooterLeft" DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" SizeChanged="OnFooterLayoutChanged">
                    <Button x:Name="InfoButton" Style="{StaticResource IconButton}" ToolTip="{loc:T image.infoTip}"
                            Click="OnInfoClicked" Margin="-6,0,4,0">
                        <views:LucideIcon Kind="info" Size="15"/>
                    </Button>
                    <TextBlock x:Name="DimensionsText" Text=""
                               Foreground="#F6F1E9" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Ellipse Width="3" Height="3" Fill="#5A534B" Margin="9,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FileSizeText" Text="" Foreground="#B5AB9D" FontSize="12" VerticalAlignment="Center"/>
                    <Ellipse Width="3" Height="3" Fill="#5A534B" Margin="9,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FormatText" Text="" Foreground="#B5AB9D" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel x:Name="FooterRight" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" SizeChanged="OnFooterLayoutChanged">
                    <ToggleButton x:Name="FilmstripButton" Style="{StaticResource IconButton}" ToolTip="{loc:T image.filmstripTip}" Click="OnFilmstripClicked">
                        <views:LucideIcon Kind="gallery" Size="15"/>
                    </ToggleButton>

                    <Rectangle Width="1" Height="16" Fill="#3B3631" Margin="8,0"/>

                    <Button Style="{StaticResource IconButton}" ToolTip="{loc:T zoom.out}" Click="OnZoomOutClicked">
                        <views:LucideIcon Kind="zoom-out" Size="15"/>
                    </Button>
                    <TextBlock x:Name="ZoomText" Text="100%" Foreground="#E3B341" FontSize="12" FontWeight="Medium"
                               Width="44" TextAlignment="Center" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource IconButton}" ToolTip="{loc:T zoom.in}" Click="OnZoomInClicked">
                        <views:LucideIcon Kind="zoom-in" Size="15"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="{loc:T zoom.fit}" Click="OnResetZoomClicked">
                        <views:LucideIcon Kind="scan" Size="15"/>
                    </Button>

                    <Rectangle Width="1" Height="16" Fill="#3B3631" Margin="8,0"/>

                    <Button Style="{StaticResource IconButton}" ToolTip="{loc:T image.rotateLeftTip}" Click="OnRotateLeftClicked">
                        <views:LucideIcon Kind="rotate-ccw" Size="15"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="{loc:T image.rotateRightTip}" Click="OnRotateRightClicked">
                        <views:LucideIcon Kind="rotate-cw" Size="15"/>
                    </Button>

                    <Rectangle Width="1" Height="16" Fill="#3B3631" Margin="8,0"/>

                    <Button x:Name="CopyImageButton" Style="{StaticResource IconButton}" ToolTip="{loc:T image.copyTip}" Click="OnCopyImageClicked">
                        <views:LucideIcon x:Name="CopyImageIcon" Kind="clipboard-copy" Size="15"/>
                    </Button>
                </StackPanel>
            </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
