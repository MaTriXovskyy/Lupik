<UserControl x:Class="Lupik.Views.ImageViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Lupik.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:Lupik.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="{DynamicResource c131211}"
             ClipToBounds="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Interactive Image Canvas -->
        <Border x:Name="ViewportBorder" Grid.Row="0" Background="Transparent" ClipToBounds="True"
                MouseWheel="OnMouseWheel"
                MouseLeftButtonDown="OnMouseLeftButtonDown"
                MouseLeftButtonUp="OnMouseLeftButtonUp"
                MouseMove="OnMouseMove">
            <Image x:Name="PreviewImage"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   RenderOptions.EdgeMode="Aliased">
                <!-- Rotation as a layout transform, so a rotated image still fits the viewport -->
                <Image.LayoutTransform>
                    <RotateTransform x:Name="ImageRotation" Angle="0"/>
                </Image.LayoutTransform>
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="ImageTranslate" X="0" Y="0" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
        </Border>

        <!-- Edit mode (E): the marks drawn on the picture (blur, arrows, frames, text). Covers the picture, so dragging
             draws instead of panning -->
        <Canvas x:Name="AnnotationLayer" Grid.Row="0" Background="Transparent" Visibility="Collapsed" ClipToBounds="True" Cursor="Cross"
                MouseLeftButtonDown="OnAnnotateMouseDown" MouseMove="OnAnnotateMouseMove" MouseLeftButtonUp="OnAnnotateMouseUp"
                SizeChanged="OnAnnotationLayerSizeChanged"/>

        <!-- Pipette: holding Ctrl over the picture shows the pixels under the cursor and their colour; Ctrl+click copies it -->
        <Popup x:Name="PipettePopup" Placement="Relative" PlacementTarget="{Binding ElementName=ViewportBorder}" AllowsTransparency="True"
               IsHitTestVisible="False" StaysOpen="True">
            <Border Margin="6,6,14,14" Background="{DynamicResource c1B1917}" BorderBrush="{DynamicResource c35302A}" BorderThickness="1" CornerRadius="10" Padding="6">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.5" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Width="110" Height="110">
                        <Border CornerRadius="6" ClipToBounds="True">
                            <Image x:Name="PipetteZoom" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Border>
                        <!-- The sampled pixel, in the middle of the 11 x 11 shown -->
                        <Rectangle Width="12" Height="12" Stroke="White" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Rectangle Width="14" Height="14" Stroke="Black" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <DockPanel Margin="2,6,2,0">
                        <Border x:Name="PipetteSwatch" DockPanel.Dock="Left" Width="14" Height="14" CornerRadius="3" BorderBrush="{DynamicResource c4A433B}" BorderThickness="1" Margin="0,0,7,0"/>
                        <TextBlock x:Name="PipetteHex" FontFamily="Cascadia Mono, Consolas" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource cECE6DC}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{loc:T pipette.hint}" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="2,3,2,0"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Text mode (T): drag over text to copy it, click a word to copy it; QR codes and barcodes found get a card at the top -->
        <Canvas x:Name="TextLayer" Grid.Row="0" Background="Transparent" Visibility="Collapsed" ClipToBounds="True" Cursor="Cross"
                MouseLeftButtonDown="OnTextMouseDown" MouseMove="OnTextMouseMove" MouseLeftButtonUp="OnTextMouseUp" MouseWheel="OnMouseWheel"
                SizeChanged="OnTextLayerSizeChanged">
            <Rectangle x:Name="TextSelection" Stroke="{DynamicResource Gold}" StrokeThickness="1.5" StrokeDashArray="4 3" RadiusX="3" RadiusY="3"
                       Fill="{DynamicResource GoldTint}" Opacity="0.85" Visibility="Collapsed" IsHitTestVisible="False"/>
            <Border x:Name="TextHint" Background="{DynamicResource cE61B1917}" BorderBrush="{DynamicResource c3B3631}" BorderThickness="1" CornerRadius="8" Padding="12,6" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <views:LucideIcon x:Name="TextHintIcon" Kind="scan-text" Size="14" Margin="0,0,8,0" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource Gold}"/>
                    <TextBlock x:Name="TextHintText" Foreground="{DynamicResource cECE6DC}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border x:Name="CodeCard" Background="{DynamicResource c1B1917}" BorderBrush="{DynamicResource c35302A}" BorderThickness="1" CornerRadius="10"
                    Padding="12,8" Visibility="Collapsed" Cursor="Arrow" MaxWidth="560">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.45" Color="Black"/>
                </Border.Effect>
                <StackPanel x:Name="CodeList"/>
            </Border>
        </Canvas>

        <!-- Crop mode: dimmed surroundings, gold frame with corner handles -->
        <Canvas x:Name="CropLayer" Grid.Row="0" Background="Transparent" Visibility="Collapsed" ClipToBounds="True" Cursor="Cross"
                MouseLeftButtonDown="OnCropMouseDown" MouseMove="OnCropMouseMove" MouseLeftButtonUp="OnCropMouseUp" SizeChanged="OnCropLayerSizeChanged">
            <Path x:Name="CropShade" Fill="#A6000000" IsHitTestVisible="False"/>
            <Rectangle x:Name="CropFrame" Stroke="{DynamicResource Gold}" StrokeThickness="1.5" IsHitTestVisible="False"/>
            <!-- Handles: big corners, bars in the middle of each edge (the whole edge can be dragged) -->
            <Rectangle x:Name="HandleTL" Width="20" Height="20" Fill="{DynamicResource Gold}" Stroke="{DynamicResource OnGold}" StrokeThickness="2" RadiusX="4" RadiusY="4" IsHitTestVisible="False"/>
            <Rectangle x:Name="HandleTR" Width="20" Height="20" Fill="{DynamicResource Gold}" Stroke="{DynamicResource OnGold}" StrokeThickness="2" RadiusX="4" RadiusY="4" IsHitTestVisible="False"/>
            <Rectangle x:Name="HandleBL" Width="20" Height="20" Fill="{DynamicResource Gold}" Stroke="{DynamicResource OnGold}" StrokeThickness="2" RadiusX="4" RadiusY="4" IsHitTestVisible="False"/>
            <Rectangle x:Name="HandleBR" Width="20" Height="20" Fill="{DynamicResource Gold}" Stroke="{DynamicResource OnGold}" StrokeThickness="2" RadiusX="4" RadiusY="4" IsHitTestVisible="False"/>
            <Rectangle x:Name="HandleT" Width="34" Height="10" Fill="{DynamicResource Gold}" Stroke="{DynamicResource OnGold}" StrokeThickness="2" RadiusX="4" RadiusY="4" IsHitTestVisible="False"/>
            <Rectangle x:Name="HandleB" Width="34" Height="10" Fill="{DynamicResource Gold}" Stroke="{DynamicResource OnGold}" StrokeThickness="2" RadiusX="4" RadiusY="4" IsHitTestVisible="False"/>
            <Rectangle x:Name="HandleL" Width="10" Height="34" Fill="{DynamicResource Gold}" Stroke="{DynamicResource OnGold}" StrokeThickness="2" RadiusX="4" RadiusY="4" IsHitTestVisible="False"/>
            <Rectangle x:Name="HandleR" Width="10" Height="34" Fill="{DynamicResource Gold}" Stroke="{DynamicResource OnGold}" StrokeThickness="2" RadiusX="4" RadiusY="4" IsHitTestVisible="False"/>
            <Border x:Name="CropHint" Background="{DynamicResource cE61B1917}" BorderBrush="{DynamicResource c3B3631}" BorderThickness="1" CornerRadius="8" Padding="12,6" IsHitTestVisible="False">
                <TextBlock x:Name="CropHintText" Foreground="{DynamicResource cECE6DC}" FontSize="12">
                    <Run x:Name="CropSizeRun" Text="" Foreground="{DynamicResource GoldHover}" FontWeight="SemiBold"/><Run Text="   "/><Run Text="{loc:T crop.modifiers}" Foreground="{DynamicResource cB5AB9D}"/>
                    <Run Text="   Enter" Foreground="{DynamicResource GoldHover}" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{loc:T crop.save}"/>
                    <Run Text="   Esc" Foreground="{DynamicResource GoldHover}" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{loc:T crop.cancel}"/>
                </TextBlock>
            </Border>
        </Canvas>

        <!-- Info panel (I): slides up from the footer, height animated from 0 -->
        <Border x:Name="InfoPanel" Grid.Row="1" Height="0" ClipToBounds="True" Background="{DynamicResource c181614}"
                BorderBrush="{DynamicResource c2F2B27}" BorderThickness="0,1,0,0">
            <ItemsControl x:Name="InfoItems" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="12,8,12,4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="11,0,11,6" MaxWidth="340">
                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource c8A8074}" FontSize="10.5" FontWeight="SemiBold"/>
                            <TextBlock x:Name="Value" Text="{Binding Value}" Foreground="{DynamicResource cECE6DC}" FontSize="12.5" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}"/>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Accent}" Value="True">
                                <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource Gold}"/>
                                <Setter TargetName="Value" Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Filmstrip (T): the folder's images; click one to show it. Thumbnails load only as they come into view -->
        <Border x:Name="Filmstrip" Grid.Row="2" Height="{x:Static views:ImageViewer.FilmstripHeight}" Background="{DynamicResource c161412}"
                BorderBrush="{DynamicResource c2F2B27}" BorderThickness="0,1,0,0" Visibility="Collapsed">
            <ListBox x:Name="FilmstripList" Background="Transparent" BorderThickness="0" Padding="8,0" Focusable="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel" PreviewMouseWheel="OnFilmstripWheel">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Width="76" Height="60" Margin="3,0" CornerRadius="6" BorderThickness="2"
                                            BorderBrush="Transparent" Background="{DynamicResource c1F1C19}" ToolTip="{Binding Name}"
                                            Loaded="OnFilmstripItemLoaded" MouseLeftButtonUp="OnFilmstripItemClicked">
                                        <Border CornerRadius="4" ClipToBounds="True">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource c5A534B}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Gold}"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <!-- Edit mode footer: the tools -->
        <Border x:Name="EditFooter" Grid.Row="3" Background="{DynamicResource c1B1917}" BorderBrush="{DynamicResource c3B3631}" BorderThickness="0,1,0,0" Padding="10,0" Height="44"
                Visibility="Collapsed">
            <Border.Resources>
                <Style x:Key="Tool" TargetType="RadioButton">
                    <Setter Property="Foreground" Value="{DynamicResource cB5AB9D}"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="GroupName" Value="Tools"/>
                    <Setter Property="Margin" Value="0,0,4,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource c2F2B27}" BorderThickness="1" CornerRadius="7" Padding="9,5">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource c2E2A25}"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GoldTintHover}"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Gold}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource GoldHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="Swatch" TargetType="RadioButton">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="GroupName" Value="Colors"/>
                    <Setter Property="Margin" Value="0,0,5,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="Ring" Width="22" Height="22" CornerRadius="11" BorderThickness="2" BorderBrush="Transparent" Padding="2">
                                    <Ellipse Fill="{TemplateBinding Background}" Stroke="#40FFFFFF" StrokeThickness="1"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Gold}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Border.Resources>
            <DockPanel VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="ToolBlur" Style="{StaticResource Tool}" IsChecked="True" ToolTip="{loc:T imageEdit.blurTip}">
                        <StackPanel Orientation="Horizontal"><views:LucideIcon Kind="eye-off" Size="14" Margin="0,0,6,0"/><TextBlock Text="{loc:T imageEdit.blur}"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ToolArrow" Style="{StaticResource Tool}" ToolTip="{loc:T imageEdit.arrowTip}">
                        <StackPanel Orientation="Horizontal"><views:LucideIcon Kind="move-up-right" Size="14" Margin="0,0,6,0"/><TextBlock Text="{loc:T imageEdit.arrow}"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ToolFrame" Style="{StaticResource Tool}" ToolTip="{loc:T imageEdit.frameTip}">
                        <StackPanel Orientation="Horizontal"><views:LucideIcon Kind="square" Size="14" Margin="0,0,6,0"/><TextBlock Text="{loc:T imageEdit.frame}"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ToolText" Style="{StaticResource Tool}" ToolTip="{loc:T imageEdit.textTip}">
                        <StackPanel Orientation="Horizontal"><views:LucideIcon Kind="type" Size="14" Margin="0,0,6,0"/><TextBlock Text="{loc:T imageEdit.text}"/></StackPanel>
                    </RadioButton>

                    <Rectangle Width="1" Height="18" Fill="{DynamicResource c3B3631}" Margin="8,0,10,0"/>
                    <RadioButton x:Name="ColorRed" Style="{StaticResource Swatch}" Background="#E5302A" IsChecked="True"/>
                    <RadioButton x:Name="ColorYellow" Style="{StaticResource Swatch}" Background="#FFD02E"/>
                    <RadioButton x:Name="ColorWhite" Style="{StaticResource Swatch}" Background="#FFFFFF"/>
                    <RadioButton x:Name="ColorBlack" Style="{StaticResource Swatch}" Background="#111111"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="EditSizeText" Foreground="{DynamicResource cB5AB9D}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="12" Click="OnResizeClicked" Margin="0,0,6,0" ToolTip="{loc:T imageEdit.resizeTip}">
                        <StackPanel Orientation="Horizontal"><views:LucideIcon Kind="shrink" Size="13" Margin="0,0,6,0"/><TextBlock Text="{loc:T imageEdit.resize}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="OnUndoClicked" ToolTip="{loc:T imageEdit.undoTip}">
                        <views:LucideIcon Kind="undo-2" Size="15"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Footer: never covers the image -->
        <Border x:Name="Footer" Grid.Row="3" Background="{DynamicResource c1B1917}" BorderBrush="{DynamicResource c2F2B27}" BorderThickness="0,1,0,0" Padding="12,0" Height="36">
            <Grid x:Name="FooterGrid" SizeChanged="OnFooterLayoutChanged">
            <!-- Key hints, centered in the footer; hidden when they'd run into the side groups (narrow window) -->
            <StackPanel x:Name="FooterHints" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource c8A8074}">
                <StackPanel.Resources>
                    <Style x:Key="Cap" TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource c3B3631}"/>
                        <Setter Property="BorderThickness" Value="1,1,1,2"/>
                        <Setter Property="CornerRadius" Value="4"/>
                        <Setter Property="Padding" Value="5,0,5,1"/>
                        <Setter Property="Margin" Value="0,0,3,0"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </StackPanel.Resources>
                <Button x:Name="HelpButton" Style="{StaticResource HelpCapButton}" ToolTip="{loc:T help.tip}" Click="OnHelpClicked"/>
                <Border Style="{StaticResource Cap}"><TextBlock Text="←" FontSize="10.5" Foreground="{DynamicResource cB5AB9D}"/></Border>
                <Border Style="{StaticResource Cap}"><TextBlock Text="→" FontSize="10.5" Foreground="{DynamicResource cB5AB9D}"/></Border>
                <TextBlock Text="{loc:T hint.prevNext}" FontSize="11" VerticalAlignment="Center" Margin="3,0,18,0"/>
                <Border Style="{StaticResource Cap}"><TextBlock Text="{loc:T key.preview}" FontSize="10.5" Foreground="{DynamicResource cB5AB9D}"/></Border>
                <TextBlock Text="{loc:T hint.close}" FontSize="11" VerticalAlignment="Center" Margin="3,0,0,0"/>
            </StackPanel>
            <DockPanel LastChildFill="False" VerticalAlignment="Center">
                <StackPanel x:Name="FooterLeft" DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" SizeChanged="OnFooterLayoutChanged">
                    <Button x:Name="InfoButton" Style="{StaticResource IconButton}" ToolTip="{loc:T image.infoTip}"
                            Click="OnInfoClicked" Margin="-6,0,4,0">
                        <views:LucideIcon Kind="info" Size="15"/>
                    </Button>
                    <TextBlock x:Name="DimensionsText" Text=""
                               Foreground="{DynamicResource cF6F1E9}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Ellipse Width="3" Height="3" Fill="{DynamicResource c5A534B}" Margin="9,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FileSizeText" Text="" Foreground="{DynamicResource cB5AB9D}" FontSize="12" VerticalAlignment="Center"/>
                    <Ellipse Width="3" Height="3" Fill="{DynamicResource c5A534B}" Margin="9,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FormatText" Text="" Foreground="{DynamicResource cB5AB9D}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel x:Name="FooterRight" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" SizeChanged="OnFooterLayoutChanged">
<Button Style="{StaticResource IconButton}" ToolTip="{loc:T zoom.out}" Click="OnZoomOutClicked">
                        <views:LucideIcon Kind="zoom-out" Size="15"/>
                    </Button>
                    <TextBlock x:Name="ZoomText" Text="100%" Foreground="{DynamicResource Gold}" FontSize="12" FontWeight="Medium"
                               Width="44" TextAlignment="Center" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource IconButton}" ToolTip="{loc:T zoom.in}" Click="OnZoomInClicked">
                        <views:LucideIcon Kind="zoom-in" Size="15"/>
                    </Button>

                    <Rectangle Width="1" Height="16" Fill="{DynamicResource c3B3631}" Margin="8,0"/>

                    <Button Style="{StaticResource IconButton}" ToolTip="{loc:T image.rotateLeftTip}" Click="OnRotateLeftClicked">
                        <views:LucideIcon Kind="rotate-ccw" Size="15"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="{loc:T image.rotateRightTip}" Click="OnRotateRightClicked">
                        <views:LucideIcon Kind="rotate-cw" Size="15"/>
                    </Button>

                    <Rectangle Width="1" Height="16" Fill="{DynamicResource c3B3631}" Margin="8,0"/>

                    <Button x:Name="CopyImageButton" Style="{StaticResource IconButton}" ToolTip="{loc:T image.copyTip}" Click="OnCopyImageClicked">
                        <views:LucideIcon x:Name="CopyImageIcon" Kind="clipboard-copy" Size="15"/>
                    </Button>
                    <!-- Text in the picture (O), next to copying the picture -->
                    <ToggleButton x:Name="TextButton" Style="{StaticResource IconButton}" Click="OnTextClicked" ToolTip="{loc:T image.textTip}">
                        <views:LucideIcon Kind="scan-text" Size="15"/>
                    </ToggleButton>
                </StackPanel>
            </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
