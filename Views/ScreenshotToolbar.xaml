<UserControl x:Class="Lupik.Views.ScreenshotToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Lupik.Views" xmlns:loc="clr-namespace:Lupik.Localization">
    <UserControl.Resources>
        <Style x:Key="CaptureMode" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="3,0"/><Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Tile" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource c2C2721}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource GoldTintAlt}"/>
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Gold}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="BrandHost" Grid.Column="0" HorizontalAlignment="Right" Background="{DynamicResource c1B1917}"
                BorderBrush="{DynamicResource c35302A}" BorderThickness="1,1,0,1" CornerRadius="13,0,0,13" Padding="12,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{DynamicResource AppLogo}" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Lupik" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="9,0,0,0"/>
                </StackPanel>
        </Border>
        <Border x:Name="ModeHost" Grid.Column="1" Background="{DynamicResource c1B1917}" BorderBrush="{DynamicResource c35302A}"
                BorderThickness="1" CornerRadius="0,13,13,0" Padding="8">
                <UniformGrid x:Name="Modes" Columns="4">
                <RadioButton x:Name="RegionMode" GroupName="Capture" Style="{StaticResource CaptureMode}" Tag="Region" Click="OnModePicked" ToolTip="1">
                    <StackPanel><views:LucideIcon Kind="scan" Size="19" HorizontalAlignment="Center"/><TextBlock Text="{loc:T capture.modeRegion}" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel>
                </RadioButton>
                <RadioButton x:Name="WindowMode" GroupName="Capture" Style="{StaticResource CaptureMode}" Tag="Window" Click="OnModePicked" ToolTip="2">
                    <StackPanel><views:LucideIcon Kind="app-window" Size="19" HorizontalAlignment="Center"/><TextBlock Text="{loc:T capture.modeWindow}" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel>
                </RadioButton>
                <RadioButton x:Name="MonitorMode" GroupName="Capture" Style="{StaticResource CaptureMode}" Tag="Monitor" Click="OnModePicked" ToolTip="3">
                    <StackPanel><views:LucideIcon Kind="monitor" Size="19" HorizontalAlignment="Center"/><TextBlock Text="{loc:T capture.modeMonitor}" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel>
                </RadioButton>
                <RadioButton x:Name="DesktopMode" GroupName="Capture" Style="{StaticResource CaptureMode}" Tag="Desktop" Click="OnModePicked" ToolTip="4">
                    <StackPanel><views:LucideIcon Kind="layers" Size="19" HorizontalAlignment="Center"/><TextBlock Text="{loc:T capture.modeDesktop}" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel>
                </RadioButton>
                </UniformGrid>
        </Border>
    </Grid>
</UserControl>
