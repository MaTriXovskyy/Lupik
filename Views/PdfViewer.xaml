<UserControl x:Class="QuickPeek.Views.PdfViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:views="clr-namespace:QuickPeek.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#18181B">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Tool / Status Bar -->
        <Border Grid.Row="0" Background="#27272A" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel LastChildFill="False">
                <!-- Page Indicator and File Info -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border Background="#3B82F6" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                        <TextBlock Text="PDF" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <TextBlock x:Name="PageIndicatorText" Text="Strona 1 z 1" Foreground="#F4F4F5" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="•" Foreground="#71717A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="FileSizeText" Text="1.2 MB" Foreground="#A1A1AA" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Zoom (opening externally lives in the title bar) -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" ToolTip="Pomniejsz (Ctrl+kółko)" Click="OnZoomOutClicked">
                        <views:LucideIcon Kind="zoom-out" Size="15"/>
                    </Button>
                    <TextBlock x:Name="ZoomPercentText" Text="100%" Foreground="#38BDF8" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center" Width="44" TextAlignment="Center"/>
                    <Button Style="{StaticResource IconButton}" ToolTip="Powiększ (Ctrl+kółko)" Click="OnZoomInClicked">
                        <views:LucideIcon Kind="zoom-in" Size="15"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Pages ScrollViewer -->
        <ScrollViewer Grid.Row="1" x:Name="PagesScrollViewer"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      ScrollChanged="OnScrollChanged"
                      PreviewMouseWheel="OnPreviewMouseWheel">
            <StackPanel x:Name="PagesPanel" HorizontalAlignment="Center" Margin="16" />
        </ScrollViewer>
    </Grid>
</UserControl>
