<UserControl x:Class="Lupik.Views.PdfViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Lupik.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:views="clr-namespace:Lupik.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#131211">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar: file info on the left, page navigation in the middle, zoom on the right -->
        <Border Grid.Row="0" Background="#24211E" BorderBrush="#3B3631" BorderThickness="0,0,0,1" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Border Background="#E3B341" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                        <TextBlock x:Name="FormatBadgeText" Text="PDF" Foreground="#1A1407" FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <TextBlock x:Name="FileSizeText" Text="" Foreground="#B5AB9D" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Previous · [page] / total · next. The page box takes typed digits through the keyboard hook:
                     the preview never has the keyboard focus (see MainWindow.HandleHookKey) -->
                <StackPanel Grid.Column="1" x:Name="PageNavigation" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <Button x:Name="PrevPageButton" Style="{StaticResource IconButton}" ToolTip="{loc:T pdf.prevPageTip}" Click="OnPrevPageClicked">
                        <views:LucideIcon Kind="chevron-up" Size="15"/>
                    </Button>
                    <Border x:Name="PageBox" MinWidth="46" Height="26" Margin="6,0,6,0" CornerRadius="6" Padding="8,0"
                            Background="#161412" BorderBrush="#3B3631" BorderThickness="1" Cursor="IBeam"
                            ToolTip="{loc:T pdf.pageBoxTip}" MouseLeftButtonDown="OnPageBoxClicked">
                        <TextBlock x:Name="PageBoxText" Foreground="#F6F1E9" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="PageTotalText" Foreground="#B5AB9D" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button x:Name="NextPageButton" Style="{StaticResource IconButton}" ToolTip="{loc:T pdf.nextPageTip}" Click="OnNextPageClicked">
                        <views:LucideIcon Kind="chevron-down" Size="15"/>
                    </Button>
                </StackPanel>

                <!-- Zoom (opening externally lives in the title bar) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconButton}" ToolTip="{loc:T pdf.zoomOutTip}" Click="OnZoomOutClicked">
                        <views:LucideIcon Kind="zoom-out" Size="15"/>
                    </Button>
                    <TextBlock x:Name="ZoomPercentText" Text="100%" Foreground="#E3B341" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center" Width="44" TextAlignment="Center"/>
                    <Button Style="{StaticResource IconButton}" ToolTip="{loc:T pdf.zoomInTip}" Click="OnZoomInClicked">
                        <views:LucideIcon Kind="zoom-in" Size="15"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Edit mode (E): what can be done to the pages -->
        <Border x:Name="EditToolbar" Grid.Row="1" Background="#1B1917" BorderBrush="#3B3631" BorderThickness="0,0,0,1" Padding="14,6" Visibility="Collapsed">
            <Border.Resources>
                <Style x:Key="EditTool" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                    <Setter Property="Padding" Value="10,5"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Margin" Value="0,0,6,0"/>
                </Style>
            </Border.Resources>
            <WrapPanel VerticalAlignment="Center">
                <TextBlock x:Name="EditPageText" Foreground="#E3B341" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Style="{StaticResource EditTool}" Click="OnRotateLeftClicked" ToolTip="{loc:T pdfEdit.rotateLeftTip}">
                    <StackPanel Orientation="Horizontal"><views:LucideIcon Kind="rotate-ccw" Size="13" Margin="0,0,6,0"/><TextBlock Text="{loc:T pdfEdit.rotateLeft}"/></StackPanel>
                </Button>
                <Button Style="{StaticResource EditTool}" Click="OnRotateRightClicked" ToolTip="{loc:T pdfEdit.rotateRightTip}">
                    <StackPanel Orientation="Horizontal"><views:LucideIcon Kind="rotate-cw" Size="13" Margin="0,0,6,0"/><TextBlock Text="{loc:T pdfEdit.rotateRight}"/></StackPanel>
                </Button>
                <Button Style="{StaticResource EditTool}" Click="OnDeletePageClicked" ToolTip="{loc:T pdfEdit.deleteTip}">
                    <StackPanel Orientation="Horizontal"><views:LucideIcon Kind="trash-2" Size="13" Margin="0,0,6,0"/><TextBlock Text="{loc:T pdfEdit.delete}"/></StackPanel>
                </Button>
                <Rectangle Width="1" Height="18" Fill="#3B3631" Margin="6,0,12,0" VerticalAlignment="Center"/>
                <Button Style="{StaticResource EditTool}" Click="OnExtractClicked" ToolTip="{loc:T pdfEdit.extractTip}">
                    <StackPanel Orientation="Horizontal"><views:LucideIcon Kind="copy" Size="13" Margin="0,0,6,0"/><TextBlock Text="{loc:T pdfEdit.extract}"/></StackPanel>
                </Button>
                <Button Style="{StaticResource EditTool}" Click="OnAppendClicked" ToolTip="{loc:T pdfEdit.appendTip}">
                    <StackPanel Orientation="Horizontal"><views:LucideIcon Kind="plus" Size="13" Margin="0,0,6,0"/><TextBlock Text="{loc:T pdfEdit.append}"/></StackPanel>
                </Button>
            </WrapPanel>
        </Border>

        <!-- Pages ScrollViewer -->
        <ScrollViewer Grid.Row="2" x:Name="PagesScrollViewer"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      ScrollChanged="OnScrollChanged"
                      SizeChanged="OnViewportSizeChanged"
                      PreviewMouseWheel="OnPreviewMouseWheel">
            <!-- Layout rounding keeps every page on whole device pixels: a page starting at x.5 would be blurred -->
            <StackPanel x:Name="PagesPanel" HorizontalAlignment="Center" Margin="16,16,16,0" UseLayoutRounding="True" />
        </ScrollViewer>
    </Grid>
</UserControl>
