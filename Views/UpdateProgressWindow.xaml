<Window x:Class="Lupik.Views.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Lupik.Localization"
        xmlns:views="clr-namespace:Lupik.Views"
        Title="{loc:T update.dialogTitle}"
        Icon="pack://application:,,,/Lupik;component/app.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen" Topmost="True"
        FontFamily="{StaticResource AppFont}">
    <!-- Margin leaves room for the shadow around the card -->
    <Border x:Name="Card" Margin="28" Width="420" Background="{DynamicResource c1B1917}" BorderBrush="{DynamicResource c35302A}" BorderThickness="1" CornerRadius="16"
            RenderTransformOrigin="0.5,0.5" Opacity="0" MouseLeftButtonDown="OnDrag">
        <Border.RenderTransform>
            <ScaleTransform x:Name="CardScale" ScaleX="0.96" ScaleY="0.96"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="10" Direction="270" Opacity="0.55" Color="Black"/>
        </Border.Effect>

        <StackPanel Margin="22,22,22,22">
            <DockPanel>
                <Image DockPanel.Dock="Left" Source="{DynamicResource AppLogo}" Width="52" Height="52" Margin="0,0,16,0"
                       RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Top"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="HeadingText" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource cFBF8F2}"/>
                    <TextBlock x:Name="StatusText" FontSize="12.5" Foreground="{DynamicResource cB5AB9D}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>

            <!-- Gold progress bar with the percentage next to it -->
            <DockPanel Margin="0,20,0,0">
                <TextBlock x:Name="PercentText" DockPanel.Dock="Right" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource GoldHover}"
                           MinWidth="40" TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <Grid x:Name="Track" Height="8" VerticalAlignment="Center" SizeChanged="OnTrackSized">
                    <Border Background="{DynamicResource c24211E}" CornerRadius="4"/>
                    <Border x:Name="Fill" Background="{DynamicResource GoldGradient}" CornerRadius="4" HorizontalAlignment="Left" Width="0"/>
                </Grid>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
