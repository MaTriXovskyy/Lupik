<UserControl x:Class="QuickPeek.Views.CodeViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:views="clr-namespace:QuickPeek.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#1E1E2E">
    <UserControl.Resources>
        <!-- Slim, rounded dark scrollbars -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" Background="#45475A" CornerRadius="4"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#585B70"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6C7086"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="MinHeight" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="2">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Pill-shaped toolbar button -->
        <Style x:Key="ToolbarButton" TargetType="ButtonBase">
            <Setter Property="Foreground" Value="#BAC2DE"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="#313244" BorderThickness="1" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#313244"/>
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3B3452"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CBA6F7"/>
                                <Setter Property="Foreground" Value="#CBA6F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#181825" BorderBrush="#262637" BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border Background="#2A2540" BorderBrush="#4B3F6B" BorderThickness="1" CornerRadius="10" Padding="9,2" Margin="0,0,12,0">
                        <TextBlock x:Name="LanguageText" Text="C#" Foreground="#CBA6F7" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock x:Name="LinesCountText" Text="142 linii" Foreground="#7F849C" FontSize="12" VerticalAlignment="Center"/>
                    <Ellipse Width="3" Height="3" Fill="#45475A" VerticalAlignment="Center" Margin="10,0"/>
                    <TextBlock x:Name="FileSizeText" Text="12.5 KB" Foreground="#7F849C" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <ToggleButton x:Name="WordWrapToggle" Style="{StaticResource ToolbarButton}"
                                  Margin="0,0,8,0" ToolTip="Zawijanie wierszy"
                                  Checked="OnWordWrapChanged" Unchecked="OnWordWrapChanged">
                        <StackPanel Orientation="Horizontal"><views:LucideIcon Kind="wrap-text" Size="14" Margin="0,0,6,0"/><TextBlock Text="Zawijanie" VerticalAlignment="Center"/></StackPanel>
                    </ToggleButton>
                    <Button x:Name="CopyButton" Style="{StaticResource ToolbarButton}"
                            ToolTip="Kopiuj całą zawartość" Click="OnCopyClicked">
                        <StackPanel Orientation="Horizontal"><views:LucideIcon x:Name="CopyIcon" Kind="copy" Size="14" Margin="0,0,6,0"/><TextBlock x:Name="CopyText" Text="Kopiuj" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Code area -->
        <avalonEdit:TextEditor Grid.Row="1"
                               x:Name="TextEditorControl"
                               FontFamily="Cascadia Mono, Cascadia Code, JetBrains Mono, Consolas"
                               FontSize="13"
                               Foreground="#CDD6F4"
                               Background="#1E1E2E"
                               LineNumbersForeground="#45475A"
                               Padding="0,8,0,8"
                               IsReadOnly="True"
                               ShowLineNumbers="True"
                               WordWrap="False"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Auto"/>
    </Grid>
</UserControl>
