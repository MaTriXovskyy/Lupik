<Window x:Class="QuickPeek.Views.ConfirmDeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:QuickPeek.Views"
        Title="Przenieś do Kosza"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}"
        PreviewKeyDown="OnKeyDown">
    <!-- Margin leaves room for the shadow around the card -->
    <Border x:Name="Card" Margin="28" Width="420" Background="#1B1917" BorderBrush="#35302A" BorderThickness="1" CornerRadius="16"
            RenderTransformOrigin="0.5,0.5" Opacity="0" MouseLeftButtonDown="OnDrag">
        <Border.RenderTransform>
            <ScaleTransform x:Name="CardScale" ScaleX="0.96" ScaleY="0.96"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="10" Direction="270" Opacity="0.55" Color="Black"/>
        </Border.Effect>

        <StackPanel Margin="22,22,22,20">
            <DockPanel>
                <!-- What is being deleted: its thumbnail (or icon), with a small red trash badge -->
                <Grid DockPanel.Dock="Left" Width="76" Height="76" Margin="0,0,16,0" VerticalAlignment="Top">
                    <Border CornerRadius="12" Background="#24211E" BorderBrush="#2F2B27" BorderThickness="1" ClipToBounds="True">
                        <Image x:Name="Thumb" Stretch="Uniform" Margin="6" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <Border Width="26" Height="26" CornerRadius="13" Background="#E5534B" BorderBrush="#1B1917" BorderThickness="2"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-6">
                        <views:LucideIcon Kind="trash-2" Size="12" StrokeWidth="2.25" HorizontalAlignment="Center" TextElement.Foreground="White"/>
                    </Border>
                </Grid>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="HeadingText" Text="Przenieść do Kosza?" FontFamily="{StaticResource DisplayFont}"
                               FontSize="19" FontWeight="SemiBold" Foreground="#FBF8F2"/>
                    <TextBlock x:Name="NameText" Text="plik.png" FontSize="13.5" Foreground="#ECE6DC" Margin="0,6,0,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="300" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="MetaText" Text="PNG · 2,4 MB" FontSize="12" Foreground="#8A8074" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Style="{StaticResource SecondaryButton}" Click="OnCancel" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Anuluj" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource KeyHint}" Background="#3B3631">
                            <TextBlock Text="Esc" FontSize="10.5" Foreground="#B5AB9D"/>
                        </Border>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Background="#E5534B" Foreground="White" Click="OnConfirm">
                    <StackPanel Orientation="Horizontal">
                        <views:LucideIcon Kind="trash-2" Size="14" Margin="0,0,8,0"/>
                        <TextBlock Text="Przenieś do Kosza" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource KeyHint}">
                            <TextBlock Text="Enter" FontSize="10.5" Foreground="#FFE9E7"/>
                        </Border>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
