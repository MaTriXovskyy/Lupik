<UserControl x:Class="Lupik.Views.ArchiveViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Lupik.Views"
             Background="#131211">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Summary bar -->
        <Border Grid.Row="0" Background="#1B1917" BorderBrush="#2F2B27" BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel LastChildFill="True">
                <!-- Extract: button, then progress, then result -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ExtractButton" Style="{StaticResource PillButton}" Click="OnExtractClicked"
                            ToolTip="Rozpakowuje archiwum obok pliku">
                        <StackPanel Orientation="Horizontal">
                            <views:LucideIcon Kind="package-open" Size="14" Margin="0,0,7,0"/>
                            <TextBlock Text="Rozpakuj" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <StackPanel x:Name="ExtractProgressPanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                        <Grid Width="160" Height="6" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Border Background="#24211E" CornerRadius="3"/>
                            <Border x:Name="ExtractProgressFill" Background="#E3B341" CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
                        </Grid>
                        <TextBlock x:Name="ExtractProgressText" Foreground="#B5AB9D" FontSize="12" VerticalAlignment="Center" MinWidth="120"/>
                        <Button Style="{StaticResource IconButton}" ToolTip="Anuluj rozpakowywanie" Click="OnExtractCancel" Margin="4,0,0,0">
                            <views:LucideIcon Kind="x" Size="14"/>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="ExtractDonePanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                        <views:LucideIcon Kind="check" Size="14" Margin="0,0,6,0" TextElement.Foreground="#A6E3A1"/>
                        <TextBlock x:Name="ExtractDoneText" Foreground="#A6E3A1" FontSize="12" VerticalAlignment="Center"
                                   MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                        <Button Style="{StaticResource IconButton}" ToolTip="Pokaż rozpakowany folder" Click="OnExtractReveal" Margin="6,0,0,0">
                            <views:LucideIcon Kind="folder-open" Size="14"/>
                        </Button>
                    </StackPanel>
                </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Border Background="#2E2618" BorderBrush="#5C4A20" BorderThickness="1" CornerRadius="10" Padding="9,2" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" TextElement.Foreground="#E3B341">
                        <views:LucideIcon Kind="archive" Size="12" Margin="0,0,5,0"/>
                        <TextBlock x:Name="FormatText" Text="ZIP" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="SummaryText" Foreground="#B5AB9D" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            </DockPanel>
        </Border>

        <!-- Column headers -->
        <Grid Grid.Row="1" Margin="14,8,14,4" TextElement.Foreground="#8A8074" TextElement.FontSize="11">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="NAZWA" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Text="ROZMIAR" FontWeight="SemiBold" TextAlignment="Right"/>
            <TextBlock Grid.Column="2" Text="ZMODYFIKOWANO" FontWeight="SemiBold" TextAlignment="Right"/>
        </Grid>

        <!-- Entries (virtualized: archives can hold thousands of files) -->
        <ListBox Grid.Row="2" x:Name="EntriesList" Background="Transparent" BorderThickness="0" Padding="6,0,6,8"
                 Focusable="False" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,5">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#1F1C1A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type views:ArchiveEntryRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                            <views:LucideIcon Kind="{Binding Icon}" Size="15" Margin="0,0,8,0"
                                              TextElement.Foreground="{Binding IconBrush}"/>
                            <TextBlock Text="{Binding Name}" Foreground="#ECE6DC" FontSize="12.5" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" Foreground="#B5AB9D" FontSize="12" TextAlignment="Right" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding DateText}" Foreground="#8A8074" FontSize="12" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
