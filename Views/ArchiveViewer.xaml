<UserControl x:Class="Lupik.Views.ArchiveViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Lupik.Localization"
             xmlns:views="clr-namespace:Lupik.Views"
             Background="{DynamicResource c131211}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Summary bar -->
        <Border Grid.Row="0" Background="{DynamicResource c1B1917}" BorderBrush="{DynamicResource c2F2B27}" BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel LastChildFill="True">
                <!-- Extract: button, then progress, then result -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Shown while something is selected -->
                    <StackPanel x:Name="SelectionPanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock x:Name="SelectionText" Foreground="{DynamicResource GoldHover}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource PrimaryButton}" Padding="12,5" FontSize="12" Click="OnExtractSelectedClicked" ToolTip="{loc:T archive.extractSelectedTip}">
                            <StackPanel Orientation="Horizontal">
                                <views:LucideIcon Kind="package-open" Size="13" Margin="0,0,7,0"/>
                                <TextBlock Text="{loc:T archive.extractSelected}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Margin="4,0,0,0" Click="OnClearSelectionClicked" ToolTip="{loc:T archive.clearSelectionTip}">
                            <views:LucideIcon Kind="x" Size="14"/>
                        </Button>
                    </StackPanel>

                    <!-- Like WinRAR: "Extract here" and "Extract to Name\" -->
                    <StackPanel x:Name="ExtractButton" Orientation="Horizontal">
                        <Button Style="{StaticResource PillButton}" Click="OnExtractHereClicked" ToolTip="{loc:T archive.extractHereTip}" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <views:LucideIcon Kind="package-open" Size="14" Margin="0,0,7,0"/>
                                <TextBlock Text="{loc:T archive.extractHere}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PillButton}" Click="OnExtractToFolderClicked" ToolTip="{loc:T archive.extractToFolderTip}">
                            <StackPanel Orientation="Horizontal">
                                <views:LucideIcon Kind="folder-open" Size="14" Margin="0,0,7,0"/>
                                <TextBlock x:Name="ExtractToFolderText" VerticalAlignment="Center" MaxWidth="240" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="ExtractProgressPanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                        <Grid Width="160" Height="6" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Border Background="{DynamicResource c24211E}" CornerRadius="3"/>
                            <Border x:Name="ExtractProgressFill" Background="{DynamicResource Gold}" CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
                        </Grid>
                        <TextBlock x:Name="ExtractProgressText" Foreground="{DynamicResource cB5AB9D}" FontSize="12" VerticalAlignment="Center" MinWidth="120"/>
                        <Button Style="{StaticResource IconButton}" ToolTip="{loc:T archive.cancelTip}" Click="OnExtractCancel" Margin="4,0,0,0">
                            <views:LucideIcon Kind="x" Size="14"/>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="ExtractDonePanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                        <views:LucideIcon Kind="check" Size="14" Margin="0,0,6,0" TextElement.Foreground="{DynamicResource cA6E3A1}"/>
                        <TextBlock x:Name="ExtractDoneText" Foreground="{DynamicResource cA6E3A1}" FontSize="12" VerticalAlignment="Center"
                                   MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                        <Button Style="{StaticResource IconButton}" ToolTip="{loc:T archive.showFolderTip}" Click="OnExtractReveal" Margin="6,0,0,0">
                            <views:LucideIcon Kind="folder-open" Size="14"/>
                        </Button>
                    </StackPanel>
                </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Border Background="{DynamicResource GoldTint}" BorderBrush="{DynamicResource GoldDeep}" BorderThickness="1" CornerRadius="10" Padding="9,2" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" TextElement.Foreground="{DynamicResource Gold}">
                        <views:LucideIcon Kind="archive" Size="12" Margin="0,0,5,0"/>
                        <TextBlock x:Name="FormatText" Text="ZIP" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="SummaryText" Foreground="{DynamicResource cB5AB9D}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            </DockPanel>
        </Border>

        <!-- Column headers -->
        <Grid Grid.Row="1" Margin="14,8,14,4" TextElement.Foreground="{DynamicResource c8A8074}" TextElement.FontSize="11">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="36"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{loc:T list.name}" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Text="{loc:T list.size}" FontWeight="SemiBold" TextAlignment="Right"/>
            <TextBlock Grid.Column="2" Text="{loc:T list.modified}" FontWeight="SemiBold" TextAlignment="Right"/>
        </Grid>

        <!-- Entries (virtualized: archives can hold thousands of files) -->
        <ListBox Grid.Row="2" x:Name="EntriesList" Background="Transparent" BorderThickness="0" Padding="6,0,6,8"
                 PreviewMouseLeftButtonDown="OnRowMouseDown" PreviewMouseMove="OnRowMouseMove" PreviewMouseLeftButtonUp="OnRowMouseUp"
                 PreviewMouseRightButtonDown="OnRowRightDown" SelectionMode="Extended" SelectionChanged="OnSelectionChanged"
                 Focusable="False" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,5">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource c1F1C1A}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GoldTint}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type views:ArchiveEntryRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <views:TreeGuides Position="{Binding Tree}"/>
                            <!-- Windows' own icon for the file type / folder -->
                            <Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="{Binding Name}" Foreground="{Binding NameBrush}" FontSize="12.5" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" Foreground="{DynamicResource cB5AB9D}" FontSize="12" TextAlignment="Right" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding DateText}" Foreground="{DynamicResource c8A8074}" FontSize="12" TextAlignment="Right" VerticalAlignment="Center"/>
                        <!-- Extract just this one, next to the archive (shown on hover) -->
                        <Button x:Name="RowExtract" Grid.Column="3" Style="{StaticResource IconButton}" Width="26" Height="24" Padding="0"
                                HorizontalAlignment="Right" Click="OnExtractOneClicked" ToolTip="{loc:T archive.extractOneTip}" Visibility="Hidden">
                            <views:LucideIcon Kind="package-open" Size="14"/>
                        </Button>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                            <Setter TargetName="RowExtract" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Holding the right button on a file: a small preview next to the cursor -->
        <Popup x:Name="PeekPopup" Placement="Mouse" HorizontalOffset="18" VerticalOffset="12" AllowsTransparency="True"
               StaysOpen="True" IsHitTestVisible="False" PopupAnimation="Fade">
            <Border Margin="8,4,16,18" MaxWidth="440" Background="{DynamicResource c1B1917}" BorderBrush="{DynamicResource c35302A}"
                    BorderThickness="1" CornerRadius="12" Padding="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.5" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <DockPanel Margin="2,0,2,8">
                        <Image x:Name="PeekIcon" Width="16" Height="16" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="PeekSize" DockPanel.Dock="Right" FontSize="11.5" Foreground="{DynamicResource TextMuted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PeekName" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Grid MinWidth="220" MinHeight="90">
                        <Border Background="{DynamicResource c131211}" CornerRadius="8"/>
                        <Image x:Name="PeekImage" MaxWidth="420" MaxHeight="300" Margin="4" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="PeekText" MaxWidth="420" MaxHeight="300" Margin="10,8" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                   Foreground="{DynamicResource cECE6DC}" TextTrimming="CharacterEllipsis"/>
                        <views:LucideIcon x:Name="PeekLoading" Kind="loader-circle" Size="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{DynamicResource Gold}"/>
                    </Grid>
                    <!-- Footer: the picture's real size -->
                    <TextBlock x:Name="PeekFooter" HorizontalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Margin="0,8,0,0"
                               Foreground="{DynamicResource cB5AB9D}" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- How to get files out -->
        <TextBlock Grid.Row="3" Text="{loc:T archive.itemHint}" Foreground="{DynamicResource c6B6259}" FontSize="11.5" HorizontalAlignment="Center"
                   Margin="0,4,0,8" TextTrimming="CharacterEllipsis"/>
    </Grid>
</UserControl>
